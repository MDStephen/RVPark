@model asp_net_web_app.Models.IFilterableListPage

@{
    var _filterKeys = Model.Filters
        .SelectMany(f => f.Type is "StartDate" or "EndDate" ? new[] { $"{f.Name}_{f.Type}" } : new[] { f.Name })
        .ToHashSet();
}
<form method="get">
    @foreach (var kvp in Html.ViewContext.HttpContext.Request.Query)
    {
        if (!_filterKeys.Contains(kvp.Key))
        {
            <input type="hidden" name="@kvp.Key" value="@kvp.Value" />
        }
    }
    <div class="container d-flex gap-3 flex-wrap align-items-end">
        @foreach (var filter in Model.Filters)
        {
            switch (filter.Type)
            {
                case "Dropdown":
                    <div class="Dropdown">
                        <label class="form-label">@filter.Name</label>
                        <select class="form-select" name="@filter.Name">
                            <option value="">-- All --</option>
                            @foreach (var value in filter.Data)
                            {
                                <option value="@value" selected="@(Html.ViewContext.HttpContext.Request.Query[filter.Name] == value)">@value</option>
                            }
                        </select>
                    </div>
                    break;

                case "StartDate":
                    <div class="StartDate">
                        <label class="form-label">@filter.Name (from)</label>
                        <input type="date" class="form-control"
                               name="@($"{filter.Name}_StartDate")"
                               value="@Html.ViewContext.HttpContext.Request.Query[$"{filter.Name}_StartDate"]" />
                    </div>
                    break;

                case "EndDate":
                    <div class="EndDate">
                        <label class="form-label">@filter.Name (to)</label>
                        <input type="date" class="form-control"
                               name="@($"{filter.Name}_EndDate")"
                               value="@Html.ViewContext.HttpContext.Request.Query[$"{filter.Name}_EndDate"]" />
                    </div>
                    break;

                case "Search":
                    <div class="Search">
                        <label class="form-label">@filter.Name</label>
                        <input type="text" class="form-control"
                               name="@filter.Name"
                               value="@Html.ViewContext.HttpContext.Request.Query[filter.Name]"
                               placeholder="Search @filter.Name..." />
                    </div>
                    break;
            }
        }
        <div>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
    </div>
</form>
