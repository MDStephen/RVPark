<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reservation Manager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: #181b1e;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rvpark-navbar sticky-top shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-page="/CustomerFacing/Index">
                    <img src="~/images/fighter-jet.png" alt="" width="32" height="32" class="rounded-circle" style="filter: invert(1);"/>
                    RVPARK
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#extNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="extNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/Dashboard"><i class="bi bi-grid nav-icon"></i><span class="fs-6">Dashboard</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/AdminManageReservations"><i class="bi bi-calendar3 nav-icon"></i><span class="fs-6">Reservations</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/ManageUsers"><i class="bi bi-people nav-icon"></i><span class="fs-6">Users</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/AdminManageSite"><i class="bi bi-geo-alt nav-icon"></i><span class="fs-6">Sites</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/AdminReportGenerator"><i class="bi bi-bar-chart nav-icon"></i><span class="fs-6">Reports</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/Admin/Pricing"><i class="bi bi-cash-coin nav-icon"></i><span class="fs-6">Pricing</span></a></li>
                        <li class="nav-item"><a class="nav-link d-flex align-items-center gap-2 px-3 py-2 text-white" asp-area="" asp-page="/CustomerFacing/Index"><i class="bi bi-box-arrow-up-right nav-icon"></i><span class="fs-6">Website</span></a></li>

                        <li class="nav-item my-2 my-lg-0 mx-lg-2">
                            <span class="nav-divider d-none d-lg-block"></span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main content -->
    <main class="main-content" role="main">
        <partial name="_DevPanel" />
        @RenderBody()
    </main>
    <script> // for dev tools panel
    document.addEventListener("keydown", e => {
        if (e.ctrlKey && e.shiftKey && e.code === "KeyE") {
            const panel = document.getElementById("dev-panel");
            panel.style.display =
                panel.style.display === "none" ? "block" : "none";
        }
    });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
