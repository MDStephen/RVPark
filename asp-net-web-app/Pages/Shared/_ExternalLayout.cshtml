@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RVPark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-dark">
    <!-- Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary" style="--bs-bg-opacity: .25;">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/CustomerFacing/Index">RVPARK</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#extNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="extNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/CustomerFacing/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Campsites/Index">Browse Sites</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/CustomerFacing/UserManageReservation">My Reservations</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            // Prefer their first name; if it's not on the cookie (e.g. staff),
                            // fall back to the username with anything from "@" onward stripped,
                            // so an email-as-username still reads like a name ("john.smith", not
                            // "john.smith@example.com").
                            var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
                            if (string.IsNullOrEmpty(displayName))
                            {
                                var rawName = User.Identity.Name ?? "";
                                var atIndex = rawName.IndexOf('@');
                                displayName = atIndex > 0 ? rawName.Substring(0, atIndex) : rawName;
                            }

                            <li class="nav-item d-flex align-items-center gap-2 ms-lg-2">
                                <span class="navbar-text text-white fw-semibold">
                                    Welcome, @displayName
                                </span>
                                <form method="post" asp-page="/CustomerFacing/Logout">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary text-white fw-semibold ms-lg-2" asp-area="" asp-page="/CustomerFacing/UserLoginPage">Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <!-- Page Body -->
    <main class="flex-grow-1 bg-dark">
        <environment include="Development">
            <partial name="_DevPanel" />
        </environment>
        @RenderBody()
    </main>
    <!-- Footer -->
    <footer class="bg-dark bg-gradient text-light mt-auto">
        <div class="container py-4">
            <div class="row gy-3">
                <div class="col-md-4">
                    <h5>RVPARK</h5>
                    <p class="mb-0">address<br />City, UT area_code</p>
                </div>
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p class="mb-0">phone number<br />email</p>
                </div>
            </div>
        </div>
        <div class="text-center border-top border-secondary py-2 small">
            &copy; @DateTime.Now.Year RVPARK. All rights reserved.
        </div>
    </footer>
    <script> // for dev tools panel
    document.addEventListener("keydown", e => {
        if (e.ctrlKey && e.shiftKey && e.code === "KeyE") {
            const panel = document.getElementById("dev-panel");
            panel.style.display =
                panel.style.display === "none" ? "block" : "none";
        }
    });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
