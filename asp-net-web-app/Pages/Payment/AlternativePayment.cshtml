@page
@model AlternativePaymentModel
@{
    ViewData["Title"] = "Employee Payment Entry";
    ViewData["Page"]  = "Payments";
}
<style>
    .flex-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .btn-custom-primary { background-color: #4f46e5; color: white; padding: 0.6rem 1.2rem; border-radius: 0.5rem; font-weight: 500; text-decoration: none; border: none; cursor: pointer; }
    .btn-custom-primary:hover { background-color: #4338ca; }
    .data-card { background-color: #171717; border: 1px solid #262626; border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); margin-bottom: 2rem; }
    .table { width: 100%; border-collapse: collapse; text-align: left; }
    .table th { padding: 1rem; border-bottom: 1px solid #262626; color: #a3a3a3; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .table td { padding: 1rem; border-bottom: 1px solid #262626; font-size: 0.875rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a3a3a3; margin-bottom: 0.5rem; }
    .form-input-field { width: 100%; background-color: #0a0a0a; color: white; border: 1px solid #262626; border-radius: 0.5rem; padding: 0.6rem 0.75rem; outline: none; font-size: 0.875rem; }
    .form-input-field:focus { border-color: #4f46e5; }
    .btn-grid-action { background: #262626; color: #d4d4d4; border: 1px solid #404040; padding: 0.4rem 0.75rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.75rem; cursor: pointer; }
    .btn-grid-action:hover { background: #404040; color: white; }
    .badge-status { padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 500; background-color: #262626; color: #d4d4d4; }
    .validation-summary-errors ul { margin: 0; padding-left: 1.25rem; color: #f87171; }
</style>

<div class="container">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
        <h1 style="font-size:1.5rem; font-weight:600; color:white; margin:0;">
            Employee Payment Entry
        </h1>

        <a asp-page="/Admin/AdminManageReservations" class="btn btn-outline-secondary">
            &larr; Back to Reservations
        </a>
    </div>

    @if (ModelState.ContainsKey("") && ModelState[""]!.Errors.Count > 0)
    {
        <div class="data-card" style="border-color:#ef4444; max-width:500px;">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="data-card" style="border-color:#34d399; max-width:500px;">
            <p style="color:#34d399; margin:0;">@Model.Message</p>
        </div>
    }

    <div class="data-card" style="max-width:500px;">
        <form method="post">
            <div class="form-group">
                <label class="form-label">Reservation ID</label>
                <input
                    type="number"
                    name="ReservationId"
                    id="reservationId"
                    class="form-input-field"
                    value="@(Model.ReservationId == 0 ? "" : Model.ReservationId.ToString())"
                    oninput="lookupBalance()"
                    required />

                <p id="balanceStatus" style="margin:0.5rem 0 0; font-size:0.8rem;"></p>
            </div>
            <!-- Payment Type -->
            <div class="form-group">
                <label class="form-label">Payment Method</label>
                <select name="paymentType" id="paymentType" class="form-input-field" onchange="updateFields()">
                    <option value="">Select Method</option>
                    <option value="Cash" selected="@(Model.PaymentType == "Cash")">Cash</option>
                    <option value="Check" selected="@(Model.PaymentType == "Check")">Check</option>
                    <option value="ManualCard" selected="@(Model.PaymentType == "ManualCard")">Manual Credit Card Entry</option>
                </select>
            </div>

            <!-- Amount (applies to every payment method) -->
            <div class="form-group">
                <label class="form-label">Payment Amount ($)</label>
                <input type="number" step="0.01" name="amount" id="amount" class="form-input-field" value="@(Model.Amount == 0 ? "" : Model.Amount.ToString("F2"))" oninput="calculateChange()" required />
            </div>

            <!-- Check Number -->
            <div class="form-group" id="checkNumberGroup" style="display:none;">
                <label class="form-label">Check Number</label>
                <input type="text" name="checkNumber" class="form-input-field" value="@Model.CheckNumber" />
            </div>

            <!-- Cash tender / change -->
            <div id="cashFields" style="display:none;">
                <div class="form-group">
                    <label class="form-label">Amount Received ($)</label>
                    <input type="number" step="0.01" name="amountReceived" id="amountReceived" class="form-input-field" value="@((Model.AmountReceived ?? 0) == 0 ? "" : (Model.AmountReceived ?? 0).ToString("F2"))" oninput="calculateChange()" />
                </div>

                <div class="form-group">
                    <label class="form-label">Change Owed ($)</label>
                    <input type="number" step="0.01" name="changeOwed" id="changeOwed" class="form-input-field" value="@Model.ChangeOwed.ToString("F2")" readonly />
                </div>
            </div>

            <!-- Manual Credit Card -->
            <div id="manualCardFields" style="display:none;">
                <p style="color:#a3a3a3; margin-bottom:0.75rem; font-size:0.8rem;">
                    Only the last 4 digits and a reference/auth number are recorded &mdash; never the full card number or CVV.
                </p>
                <div class="form-group">
                    <label class="form-label">Card Last 4 Digits</label>
                    <input type="text" name="cardLast4" maxlength="4" inputmode="numeric" pattern="[0-9]{4}" class="form-input-field" value="@Model.CardLast4" />
                </div>
                <div class="form-group">
                    <label class="form-label">Reference / Auth Number</label>
                    <input type="text" name="cardAuthReference" class="form-input-field" value="@Model.CardAuthReference" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:1rem;">Submit Payment</button>
        </form>
    </div>
</div>

<script>
    function updateFields() {
        const type = document.getElementById("paymentType").value;

        document.getElementById("checkNumberGroup").style.display = (type === "Check") ? "block" : "none";
        document.getElementById("cashFields").style.display = (type === "Cash") ? "block" : "none";
        document.getElementById("manualCardFields").style.display = (type === "ManualCard") ? "block" : "none";
    }

    function calculateChange() {
        const amount = parseFloat(document.getElementById("amount").value) || 0;
        const received = parseFloat(document.getElementById("amountReceived").value) || 0;
        const change = received - amount;

        document.getElementById("changeOwed").value = change.toFixed(2);
    }

    let balanceLookupTimer = null;
    function lookupBalance() {
        clearTimeout(balanceLookupTimer);
        balanceLookupTimer = setTimeout(fetchBalance, 350);
    }

    async function fetchBalance() {
        const idField = document.getElementById("reservationId");
        const statusEl = document.getElementById("balanceStatus");
        const amountField = document.getElementById("amount");
        const id = idField.value.trim();

        if (!id) {
            statusEl.textContent = "";
            return;
        }

        statusEl.style.color = "#a3a3a3";
        statusEl.textContent = "Looking up reservation...";

        try {
            const response = await fetch("?handler=Balance&id=" + encodeURIComponent(id), {
                headers: { "Accept": "application/json" }
            });
            const data = await response.json();

            if (!data.found) {
                statusEl.style.color = "#f87171";
                statusEl.textContent = "No reservation found with that ID.";
                return;
            }

            if (data.isPaidInFull) {
                statusEl.style.color = "#f59e0b";
                statusEl.textContent = data.customerName + " \u2014 this reservation is already paid in full.";
                amountField.value = "";
                return;
            }

            statusEl.style.color = "#34d399";
            statusEl.textContent = data.customerName + " \u2014 balance due: $" + data.remainingBalance.toFixed(2);
            if (!amountField.value) {
                amountField.value = data.remainingBalance.toFixed(2);
            }
            calculateChange();
        } catch (err) {
            statusEl.style.color = "#f87171";
            statusEl.textContent = "Couldn't look up that reservation. Please try again.";
        }
    }

    updateFields();

    @if (Model.ReservationId != 0)
    {
        <text>fetchBalance();</text>
    }
</script>
