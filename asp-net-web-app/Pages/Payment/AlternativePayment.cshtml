@page
@model AlternativePaymentModel
@{
    ViewData["Title"] = "Employee Payment Entry";
    ViewData["Page"]  = "Payments";
}
<style>
    .flex-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .btn-custom-primary { background-color: #4f46e5; color: white; padding: 0.6rem 1.2rem; border-radius: 0.5rem; font-weight: 500; text-decoration: none; border: none; cursor: pointer; }
    .btn-custom-primary:hover { background-color: #4338ca; }
    .data-card { background-color: #171717; border: 1px solid #262626; border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3); margin-bottom: 2rem; }
    .table { width: 100%; border-collapse: collapse; text-align: left; }
    .table th { padding: 1rem; border-bottom: 1px solid #262626; color: #a3a3a3; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .table td { padding: 1rem; border-bottom: 1px solid #262626; font-size: 0.875rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a3a3a3; margin-bottom: 0.5rem; }
    .form-input-field { width: 100%; background-color: #0a0a0a; color: white; border: 1px solid #262626; border-radius: 0.5rem; padding: 0.6rem 0.75rem; outline: none; font-size: 0.875rem; }
    .form-input-field:focus { border-color: #4f46e5; }
    .btn-grid-action { background: #262626; color: #d4d4d4; border: 1px solid #404040; padding: 0.4rem 0.75rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.75rem; cursor: pointer; }
    .btn-grid-action:hover { background: #404040; color: white; }
    .badge-status { padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 500; background-color: #262626; color: #d4d4d4; }
</style>

<div class="container">

    <h1 style="font-size:1.5rem; font-weight:600; color:white; margin-bottom:1.5rem;">
        Employee Payment Entry
    </h1>

    <div class="data-card" style="max-width:500px;">
        <form method="post">
            <div class="form-group">
                <label class="form-label">Reservation ID</label>
                <input type="number" name="ReservationId" class="form-input-field" required />
            </div>
            <!-- Payment Type -->
            <div class="form-group">
                <label class="form-label">Payment Method</label>
                <select name="paymentType" id="paymentType" class="form-input-field" onchange="updateFields()">
                    <option value="">Select Method</option>
                    <option value="Cash">Cash</option>
                    <option value="Check">Check</option>
                    <option value="ManualCard">Manual Credit Card Entry</option>
                </select>
            </div>

            <!-- Check Number -->
            <div class="form-group" id="checkNumberGroup" style="display:none;">
                <label class="form-label">Check Number</label>
                <input type="text" name="checkNumber" class="form-input-field" />
            </div>

            <!-- Cash Amount -->
            <div id="cashFields" style="display:none;">
                <div class="form-group">
                    <label class="form-label">Amount Due ($)</label>
                    <input type="number" step="0.01" name="amountDue" id="amountDue" class="form-input-field" />
                </div>

                <div class="form-group">
                    <label class="form-label">Amount Received ($)</label>
                    <input type="number" step="0.01" name="amountReceived" id="amountReceived" class="form-input-field" oninput="calculateChange()" />
                </div>

                <div class="form-group">
                    <label class="form-label">Change Owed ($)</label>
                    <input type="number" step="0.01" name="changeOwed" id="changeOwed" class="form-input-field" readonly />
                </div>
            </div>

            <!-- Manual Credit Card -->
            <div class="form-group" id="manualCardRedirect" style="display:none;">
                <p style="color:#a3a3a3; margin-bottom:0.5rem;">
                    Manual credit card entry requires secure processing.
                </p>
                <a asp-page="/Employee/ManualCardEntry" class="btn-primary">Go to Manual Card Entry</a>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:1rem;">Submit Payment</button>
        </form>
    </div>
</div>

<script>
    function updateFields() {
        const type = document.getElementById("paymentType").value;

        document.getElementById("checkNumberGroup").style.display = (type === "Check") ? "block" : "none";
        document.getElementById("cashFields").style.display = (type === "Cash") ? "block" : "none";
        document.getElementById("manualCardRedirect").style.display = (type === "ManualCard") ? "block" : "none";
    }

    function calculateChange() {
        const due = parseFloat(document.getElementById("amountDue").value) || 0;
        const received = parseFloat(document.getElementById("amountReceived").value) || 0;
        const change = received - due;

        document.getElementById("changeOwed").value = change.toFixed(2);
    }
</script>
