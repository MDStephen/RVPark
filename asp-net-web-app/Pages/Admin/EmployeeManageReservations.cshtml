@page
@model asp_net_web_app.Pages.EmployeeManageReservationsModel
@{
    ViewData["Title"] = "Employee - Manage Reservations";
    ViewData["Page"] = "Reservations";
}

@functions {
    string BadgeColor(string status) => status switch
    {
        "Upcoming" => "primary",
        "Cancelled" => "danger",
        "Completed" => "success",
        _ => "warning"
    };
}

<div data-bs-theme="dark" class="text-light min-vh-100 px-3 px-md-4 py-3 py-md-4">
<div class="container-fluid p-0">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h4 fw-semibold text-light mb-1">
            Manage Reservations
        </h1>

        <p class="small text-secondary mb-0">
            Look up a reservation to view details, make changes, or assist a customer on the phone.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        var isError = Model.StatusMessage.StartsWith("Could not save") || Model.StatusMessage.Contains("not found");

        <div
            class="alert @(isError ? "alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger" : "alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-success") d-flex align-items-center mb-3"
            role="alert">

            <i class="bi @(isError ? "bi-exclamation-triangle" : "bi-check-circle") me-2"></i>

            <span>@Model.StatusMessage</span>
        </div>
    }

    <div class="row g-3 g-lg-4 align-items-start">

        <!-- ===================== LEFT PANEL: search + list ===================== -->
        <div class="col-12 col-lg-4">

            <div class="card bg-dark border-secondary border-opacity-25 h-100 overflow-hidden">

                <div class="card-body p-3 border-bottom border-secondary border-opacity-25">

                    <form method="get">
                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Search
                        </label>

                        <input
                            name="search"
                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                            value="@Model.SearchTerm"
                            placeholder="Res # or customer name" />

                        <div class="d-flex gap-2 mt-2">
                            <button
                                type="submit"
                                class="btn btn-sm btn-primary">

                                Search
                            </button>

                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a
                                    asp-page=""
                                    class="btn btn-sm btn-outline-secondary">

                                    Clear
                                </a>
                            }
                        </div>
                    </form>

                    <a
                        asp-page=""
                        asp-route-mode="walkin"
                        class="btn btn-primary w-100 mt-3">

                        + New Walk-In Reservation
                    </a>

                </div>

                <div class="list-group list-group-flush" style="max-height:640px; overflow-y:auto;">

                    @if (Model.AllReservations.Any())
                    {
                        @foreach (var r in Model.AllReservations)
                        {
                            var isActive = Model.Selected != null && Model.Selected.Id == r.Id;
                            var badgeColor = BadgeColor(r.Status);

                            <a
                                asp-page=""
                                asp-route-mode="details"
                                asp-route-id="@r.Id"
                                class="list-group-item list-group-item-action bg-dark text-light border-secondary border-opacity-25 px-3 py-2 @(isActive ? "active" : "")">

                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="small fw-semibold">
                                        #@r.Id &nbsp;@r.CustomerName
                                    </span>

                                    <span class="badge rounded-pill text-@badgeColor bg-@badgeColor bg-opacity-10 border border-@badgeColor border-opacity-25">
                                        @r.Status
                                    </span>
                                </div>

                                <div class="small text-secondary mt-1">
                                    @r.StartDate.ToString("MMM d, yyyy") &ndash; @r.EndDate.ToString("MMM d, yyyy")
                                </div>

                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center text-secondary small py-4 px-3">
                            @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                                ? "No reservations found."
                                : $"No reservations match \"{Model.SearchTerm}\".")
                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- ===================== RIGHT PANEL: detail / edit ===================== -->
        <div class="col-12 col-lg-8">

            <div class="card bg-dark border-secondary border-opacity-25">

                <div class="card-body p-3 p-md-4">

                    @if (Model.Mode == "walkin")
                    {
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h1 class="h5 fw-semibold text-light mb-0">New Walk-In Reservation</h1>

                            <a
                                asp-page=""
                                class="btn btn-sm btn-outline-secondary">

                                Cancel
                            </a>
                        </div>

                        @if (Model.SelectedWalkInCustomer == null)
                        {
                            <!-- Step A: find or create the customer -->
                            <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Step 1 &ndash; Find Customer</h2>

                            <form method="get" class="mb-3">
                                <input type="hidden" name="mode" value="walkin" />

                                <div class="mb-3">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">
                                        Search by name or email
                                    </label>

                                    <input
                                        name="custQ"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        value="@Model.CustomerQuery"
                                        placeholder="e.g. Jane Doe or jane@example.com" />
                                </div>

                                <button type="submit" class="btn btn-primary">Search</button>
                            </form>

                            @if (!string.IsNullOrWhiteSpace(Model.CustomerQuery))
                            {
                                @if (Model.CustomerMatches.Any())
                                {
                                    <div class="list-group mb-4">
                                        @foreach (var c in Model.CustomerMatches)
                                        {
                                            <div class="list-group-item bg-dark text-light border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                                <div>
                                                    <div class="fw-semibold text-light">@c.FullName</div>
                                                    <div class="small text-secondary">@c.Email &middot; @c.Phone</div>
                                                </div>

                                                <a
                                                    asp-page=""
                                                    asp-route-mode="walkin"
                                                    asp-route-custId="@c.Id"
                                                    class="btn btn-sm btn-outline-primary">

                                                    Select
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-secondary small mb-4">No matching customers found for "@Model.CustomerQuery".</p>
                                }

                                <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Or Create New Customer</h2>

                                <form method="post" asp-page-handler="CreateCustomer">
                                    <input type="hidden" name="custQ" value="@Model.CustomerQuery" />

                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small text-secondary text-uppercase fw-semibold">First Name</label>
                                            <input name="firstName" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small text-secondary text-uppercase fw-semibold">Last Name</label>
                                            <input name="lastName" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small text-secondary text-uppercase fw-semibold">Email</label>
                                            <input type="email" name="email" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small text-secondary text-uppercase fw-semibold">Phone</label>
                                            <input name="phone" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Create Customer</button>
                                </form>
                            }
                        }
                        else
                        {
                            var wc = Model.SelectedWalkInCustomer;
                            <!-- Step B: reservation details -->
                            <h2 class="small text-secondary text-uppercase fw-semibold mb-1">Step 2 &ndash; Reservation Details</h2>
                            <p class="small text-secondary mb-3">Booking for: @wc.FullName</p>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Customer</div>
                                    <div class="fw-semibold text-light">@wc.FullName</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Email</div>
                                    <div class="fw-semibold text-light">@wc.Email</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Phone</div>
                                    <div class="fw-semibold text-light">@wc.Phone</div>
                                </div>
                            </div>

                            <form method="post" asp-page-handler="CreateReservation">
                                <input type="hidden" name="custId" value="@wc.Id" />

                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Site</label>
                                        <select name="siteId" class="form-select bg-dark text-light border-secondary border-opacity-25" required>
                                            <option value="">-- Select a site --</option>
                                            @foreach (var s in Model.SiteOptions)
                                            {
                                                <option value="@s.Id">@s.SiteNumber</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Total Cost</label>
                                        <input type="number" step="0.01" min="0" name="totalCost" value="0.00" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Start Date</label>
                                        <input type="date" name="startDate" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">End Date</label>
                                        <input type="date" name="endDate" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Adults</label>
                                        <input type="number" min="1" name="adults" value="1" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Children</label>
                                        <input type="number" min="0" name="children" value="0" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small text-secondary text-uppercase fw-semibold">Pets</label>
                                        <input type="number" min="0" max="4" name="pets" value="0" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">Notes</label>
                                    <textarea name="notes" rows="3" maxlength="500" class="form-control bg-dark text-light border-secondary border-opacity-25" placeholder="Special requests or notes for this reservation..."></textarea>
                                </div>

                                <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3 mt-4">
                                    <button type="submit" class="btn btn-success">Create Reservation</button>

                                    <a
                                        asp-page=""
                                        asp-route-mode="walkin"
                                        class="btn btn-outline-secondary">

                                        Back to Customer Search
                                    </a>
                                </div>
                            </form>
                        }
                    }
                    else if (Model.InvalidId)
                    {
                        <p class="text-secondary small mb-0">
                            We couldn't find that reservation. It may have been removed &mdash; try selecting one from the list.
                        </p>
                    }
                    else if (Model.Mode == "details" && Model.Selected != null)
                    {
                        var d = Model.Selected;
                        var badgeColor = BadgeColor(d.Status);

                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h1 class="h5 fw-semibold text-light mb-0">Reservation #@d.Id &ndash; @d.CustomerName</h1>

                            <span class="badge rounded-pill text-@badgeColor bg-@badgeColor bg-opacity-10 border border-@badgeColor border-opacity-25">
                                @d.Status
                            </span>
                        </div>

                        @if (d.Status == "Cancelled")
                        {
                            <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4" role="alert">
                                <span>This reservation has been cancelled.</span>

                                <form method="post" asp-page-handler="Reactivate" asp-route-id="@d.Id">
                                    <button type="submit" class="btn btn-sm btn-success">Reactivate</button>
                                </form>
                            </div>
                        }

                        <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Customer</h2>

                        @if (d.CustomerFound)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Name</div>
                                    <div class="fw-semibold text-light">@d.CustomerName</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Email</div>
                                    <div class="fw-semibold text-light">@d.CustomerEmail</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Phone</div>
                                    <div class="fw-semibold text-light">@d.CustomerPhone</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary small mb-4">Customer record not found</p>
                        }

                        <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Stay Details</h2>

                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Site</div>
                                <div class="fw-semibold text-light">@d.SiteNumber</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Check-in</div>
                                <div class="fw-semibold text-light">@d.StartDate.ToString("MMM d, yyyy")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Check-out</div>
                                <div class="fw-semibold text-light">@d.EndDate.ToString("MMM d, yyyy")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Nights</div>
                                <div class="fw-semibold text-light">@d.Nights</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Adults</div>
                                <div class="fw-semibold text-light">@d.Adults</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Children</div>
                                <div class="fw-semibold text-light">@d.Children</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Pets</div>
                                <div class="fw-semibold text-light">@d.Pets</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">RV Length</div>
                                <div class="fw-semibold text-light">Not recorded</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Total Cost</div>
                                <div class="fw-semibold text-light">@d.TotalCost.ToString("C")</div>
                            </div>
                        </div>

                        <h2 class="small text-secondary text-uppercase fw-semibold mb-2">Special Requests / Notes</h2>
                        <p class="text-secondary small mb-4">@(string.IsNullOrWhiteSpace(d.Notes) ? "None" : d.Notes)</p>

                        <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Payment Records</h2>

                        @if (d.Payments.Any())
                        {
                            <div class="card bg-dark border-secondary border-opacity-25 overflow-hidden mb-4">
                                <div class="table-responsive">
                                    <table class="table table-dark table-hover align-middle mb-0">
                                        <thead>
                                            <tr class="text-secondary small text-uppercase">
                                                <th class="ps-3 py-2">Date</th>
                                                <th class="py-2">Amount</th>
                                                <th class="py-2">Status</th>
                                                <th class="py-2">Reference</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var p in d.Payments)
                                            {
                                                <tr>
                                                    <td class="ps-3 text-light">@p.PaidAt.ToString("MMM d, yyyy")</td>
                                                    <td class="text-light">@p.Amount.ToString("C")</td>
                                                    <td class="text-light">@p.Status</td>
                                                    <td class="text-secondary">@p.StripeId</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary small mb-4">No payment records found for this reservation.</p>
                        }

                        <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3">
                            <a
                                asp-page=""
                                asp-route-id="@d.Id"
                                class="btn btn-primary">

                                Edit Reservation
                            </a>

                            <a
                                asp-page=""
                                class="btn btn-outline-secondary">

                                Back to List
                            </a>
                        </div>
                    }
                    else if (Model.Selected != null)
                    {
                        var d = Model.Selected;
                        var badgeColor = BadgeColor(d.Status);

                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h1 class="h5 fw-semibold text-light mb-0">Reservation #@d.Id &ndash; @d.CustomerName</h1>

                            <span class="badge rounded-pill text-@badgeColor bg-@badgeColor bg-opacity-10 border border-@badgeColor border-opacity-25">
                                @d.Status
                            </span>
                        </div>

                        @if (d.Status == "Cancelled")
                        {
                            <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4" role="alert">
                                <span>This reservation has been cancelled.</span>

                                <form method="post" asp-page-handler="Reactivate" asp-route-id="@d.Id">
                                    <button type="submit" class="btn btn-sm btn-success">Reactivate</button>
                                </form>
                            </div>
                        }

                        <div class="row g-3 mb-4">
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Site</div>
                                <div class="fw-semibold text-light">@d.SiteNumber</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Nights</div>
                                <div class="fw-semibold text-light">@d.Nights</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Total Cost</div>
                                <div class="fw-semibold text-light">@d.TotalCost.ToString("C")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="small text-secondary text-uppercase">Status</div>
                                <div class="fw-semibold text-light">@d.Status</div>
                            </div>
                        </div>

                        <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Customer</h2>

                        @if (d.CustomerFound)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Name</div>
                                    <div class="fw-semibold text-light">@d.CustomerName</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Email</div>
                                    <div class="fw-semibold text-light">@d.CustomerEmail</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="small text-secondary text-uppercase">Phone</div>
                                    <div class="fw-semibold text-light">@d.CustomerPhone</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary small mb-4">Customer record not found</p>
                        }

                        <form method="post" asp-page-handler="Save">
                            <input type="hidden" name="id" value="@d.Id" />

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">Start Date</label>
                                    <input type="date" name="startDate" value="@d.StartDate.ToString("yyyy-MM-dd")" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">End Date</label>
                                    <input type="date" name="endDate" value="@d.EndDate.ToString("yyyy-MM-dd")" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">Adults</label>
                                    <input type="number" min="1" name="adults" value="@d.Adults" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">Children</label>
                                    <input type="number" min="0" name="children" value="@d.Children" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">Pets</label>
                                    <input type="number" min="0" name="pets" value="@d.Pets" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">Notes</label>
                                <textarea name="notes" rows="3" class="form-control bg-dark text-light border-secondary border-opacity-25" placeholder="Special requests or notes for this reservation...">@d.Notes</textarea>
                            </div>

                            <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3 mt-4">
                                <button type="submit" class="btn btn-primary">Save Changes</button>

                                <a
                                    asp-page=""
                                    asp-route-mode="details"
                                    asp-route-id="@d.Id"
                                    class="btn btn-outline-secondary">

                                    View Details
                                </a>

                                @if (d.Status != "Cancelled")
                                {
                                    <button
                                        type="submit"
                                        formaction="?handler=Cancel&id=@d.Id"
                                        class="btn btn-outline-danger"
                                        onclick="return confirm('Cancel this reservation? The customer will need to rebook if they change their mind.');">

                                        Cancel Reservation
                                    </button>
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-secondary small mb-0">
                            Select a reservation from the list to view details and assist a customer.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
