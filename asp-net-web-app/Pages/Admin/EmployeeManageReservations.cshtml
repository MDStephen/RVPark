@page
@model asp_net_web_app.Pages.EmployeeManageReservationsModel
@{
    ViewData["Title"] = "Employee - Manage Reservations";
    ViewData["Page"] = "Reservations";
}

<style>
    .emp-wrapper {
        background-color: #1a1d21;
        color: #e4e6eb;
        border-radius: 12px;
        padding: 24px;
        min-height: 600px;
    }

    .emp-wrapper h1 {
        color: #ffffff;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .emp-subtitle {
        color: #9aa2ad;
        font-size: 0.9rem;
        margin-bottom: 20px;
    }

    .emp-card {
        background-color: #23272d;
        border-radius: 12px;
        padding: 20px;
        margin-top: 12px;
    }

    .emp-panel {
        background-color: #2b3038;
        border-radius: 8px;
        display: flex;
        min-height: 480px;
        overflow: hidden;
    }

    /* Left panel: search + list */
    .emp-left {
        width: 320px;
        border-right: 1px solid #3a4048;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
    }

    .emp-search {
        padding: 16px 16px 12px 16px;
        border-bottom: 1px solid #3a4048;
    }

    .emp-search input {
        width: 100%;
        background-color: #1f2329;
        border: 1px solid #3a4048;
        color: #e4e6eb;
        border-radius: 999px;
        padding: 8px 16px;
        font-size: 0.875rem;
    }

    .emp-search input:focus {
        outline: none;
        border-color: #4d9fff;
    }

    .emp-search-actions {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }

    .emp-list {
        overflow-y: auto;
        flex: 1;
    }

    .emp-list-item {
        display: block;
        padding: 12px 16px;
        color: #e4e6eb;
        text-decoration: none;
        border-left: 3px solid transparent;
        border-bottom: 1px solid #262b31;
    }

    .emp-list-item:hover {
        background-color: #343a43;
        color: #ffffff;
    }

    .emp-list-item.selected {
        background-color: #343a43;
        border-left-color: #4d9fff;
        color: #ffffff;
    }

    .emp-list-item .res-id {
        font-weight: 600;
        color: #ffffff;
        margin-right: 6px;
    }

    .emp-list-item .res-dates {
        display: block;
        font-size: 0.8rem;
        color: #9aa2ad;
        margin-top: 4px;
    }

    /* Right panel: detail view */
    .emp-right {
        flex-grow: 1;
        padding: 28px;
    }

    .emp-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .emp-detail-header h3 {
        color: #ffffff;
        margin: 0;
    }

    .emp-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .emp-info-item label {
        display: block;
        font-size: 0.72rem;
        color: #9aa2ad;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
    }

    .emp-info-item .value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #e4e6eb;
    }

    .emp-form label {
        color: #c8cdd4;
        font-size: 0.9rem;
        margin-bottom: 4px;
        display: block;
    }

    .emp-form .form-control,
    .emp-form .form-select {
        background-color: #1f2329;
        border: 1px solid #3a4048;
        color: #e4e6eb;
        border-radius: 8px;
        padding: 8px 14px;
    }

    .emp-form .form-control:focus,
    .emp-form .form-select:focus {
        background-color: #1f2329;
        color: #ffffff;
        border-color: #4d9fff;
        box-shadow: none;
    }

    .badge-status {
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .badge-upcoming { background-color: rgba(77, 159, 255, 0.15); color: #4d9fff; }
    .badge-cancelled { background-color: rgba(229, 72, 77, 0.15); color: #e5484d; }
    .badge-completed { background-color: rgba(16, 185, 129, 0.15); color: #10b981; }
    .badge-other { background-color: rgba(240, 160, 32, 0.15); color: #f0a020; }

    .btn-save {
        background-color: #4d9fff;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        cursor: pointer;
    }
    .btn-save:hover { background-color: #3b8ae6; color: #fff; }

    .btn-cancel-res {
        background-color: #e5484d;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
    }
    .btn-cancel-res:hover { background-color: #d13438; color: #fff; }

    .btn-reactivate {
        background-color: #10b981;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
    }
    .btn-reactivate:hover { background-color: #0d9668; color: #fff; }

    .status-note {
        background-color: #1f3a5f;
        color: #bcd8ff;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 14px;
    }

    .status-error {
        background-color: #3a1f22;
        color: #ffb3b6;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 14px;
    }

    .cancelled-banner {
        background-color: rgba(229, 72, 77, 0.12);
        border: 1px solid rgba(229, 72, 77, 0.3);
        color: #ffb3b6;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .hint-text { color: #9aa2ad; font-size: 0.9rem; padding: 20px; }

    /* Mobile responsive */
    @@media (max-width: 900px) {
        .emp-panel { flex-direction: column; min-height: 0; }
        .emp-left { width: 100%; border-right: none; border-bottom: 1px solid #3a4048; max-height: 320px; }
        .emp-right { padding: 20px; }
        .emp-info-grid { grid-template-columns: 1fr 1fr; }
    }

    @@media (max-width: 480px) {
        .emp-info-grid { grid-template-columns: 1fr; }
    }
</style>

@functions {
    string BadgeClass(string status) => status switch
    {
        "Upcoming" => "badge-upcoming",
        "Cancelled" => "badge-cancelled",
        "Completed" => "badge-completed",
        _ => "badge-other"
    };
}

<div class="emp-wrapper">
    <h1>Manage Reservations</h1>
    <p class="emp-subtitle">Look up a reservation to view details, make changes, or assist a customer on the phone.</p>

    <div class="emp-card">
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="@(Model.StatusMessage.StartsWith("Could not save") || Model.StatusMessage.Contains("not found") ? "status-error" : "status-note")">
                @Model.StatusMessage
            </div>
        }

        <div class="emp-panel">

            <!-- ===================== LEFT PANEL: search + list ===================== -->
            <div class="emp-left">
                <div class="emp-search">
                    <form method="get">
                        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by Res # or customer name" />
                        <div class="emp-search-actions">
                            <button type="submit" class="btn-save" style="padding:6px 14px; font-size:0.8rem;">Search</button>
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a asp-page="" class="btn-save" style="background-color:#3a4048; padding:6px 14px; font-size:0.8rem;">Clear</a>
                            }
                        </div>
                    </form>
                    <a asp-page="" asp-route-mode="walkin" class="btn-save"
                       style="display:block; margin-top:10px;">
                        + New Walk-In Reservation
                    </a>
                </div>

                <div class="emp-list">
                    @if (Model.AllReservations.Any())
                    {
                        @foreach (var r in Model.AllReservations)
                        {
                            <a class="emp-list-item @(Model.Selected != null && Model.Selected.Id == r.Id ? "selected" : "")"
                               asp-page="" asp-route-mode="details" asp-route-id="@r.Id">
                                <span class="res-id">#@r.Id</span>@r.CustomerName
                                <span class="badge-status @BadgeClass(r.Status)">@r.Status</span>
                                <span class="res-dates">@r.StartDate.ToString("MMM d, yyyy") &ndash; @r.EndDate.ToString("MMM d, yyyy")</span>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="hint-text">
                            @(string.IsNullOrWhiteSpace(Model.SearchTerm)
                                ? "No reservations found."
                                : $"No reservations match \"{Model.SearchTerm}\".")
                        </p>
                    }
                </div>
            </div>

            <!-- ===================== RIGHT PANEL: detail / edit ===================== -->
            <div class="emp-right">
                @if (Model.Mode == "walkin")
                {
                    <div class="emp-detail-header">
                        <h3>New Walk-In Reservation</h3>
                        <a asp-page="" class="btn-save" style="background-color:#3a4048;">Cancel</a>
                    </div>

                    @if (Model.SelectedWalkInCustomer == null)
                    {
                        <!-- Step A: find or create the customer -->
                        <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:12px;">Step 1 &ndash; Find Customer</h5>
                        <form method="get" class="emp-form mb-3">
                            <input type="hidden" name="mode" value="walkin" />
                            <div class="row mb-3">
                                <div class="col">
                                    <label>Search by name or email</label>
                                    <input class="form-control" type="text" name="custQ" value="@Model.CustomerQuery" placeholder="e.g. Jane Doe or jane@example.com" />
                                </div>
                            </div>
                            <button type="submit" class="btn-save">Search</button>
                        </form>

                        @if (!string.IsNullOrWhiteSpace(Model.CustomerQuery))
                        {
                            @if (Model.CustomerMatches.Any())
                            {
                                <div class="emp-card" style="margin-top:0;">
                                    @foreach (var c in Model.CustomerMatches)
                                    {
                                        <div class="emp-detail-header" style="margin-bottom:10px;">
                                            <div>
                                                <div class="value" style="color:#fff;">@c.FullName</div>
                                                <div class="res-dates">@c.Email &middot; @c.Phone</div>
                                            </div>
                                            <a asp-page="" asp-route-mode="walkin" asp-route-custId="@c.Id" class="btn-save">Select</a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="hint-text" style="padding:12px 0;">No matching customers found for "@Model.CustomerQuery".</p>
                            }

                            <h5 style="color:#ffffff; font-size:0.95rem; margin:20px 0 12px 0;">Or Create New Customer</h5>
                            <form method="post" asp-page-handler="CreateCustomer" class="emp-form">
                                <input type="hidden" name="custQ" value="@Model.CustomerQuery" />
                                <div class="row mb-3">
                                    <div class="col">
                                        <label>First Name</label>
                                        <input class="form-control" type="text" name="firstName" required />
                                    </div>
                                    <div class="col">
                                        <label>Last Name</label>
                                        <input class="form-control" type="text" name="lastName" required />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col">
                                        <label>Email</label>
                                        <input class="form-control" type="email" name="email" required />
                                    </div>
                                    <div class="col">
                                        <label>Phone</label>
                                        <input class="form-control" type="text" name="phone" />
                                    </div>
                                </div>
                                <button type="submit" class="btn-save">Create Customer</button>
                            </form>
                        }
                    }
                    else
                    {
                        var wc = Model.SelectedWalkInCustomer;
                        <!-- Step B: reservation details -->
                        <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:4px;">Step 2 &ndash; Reservation Details</h5>
                        <p class="res-dates" style="margin-bottom:12px;">Booking for: @wc.FullName</p>
                        <div class="emp-info-grid" style="margin-bottom:20px;">
                            <div class="emp-info-item">
                                <label>Customer</label>
                                <div class="value">@wc.FullName</div>
                            </div>
                            <div class="emp-info-item">
                                <label>Email</label>
                                <div class="value">@wc.Email</div>
                            </div>
                            <div class="emp-info-item">
                                <label>Phone</label>
                                <div class="value">@wc.Phone</div>
                            </div>
                        </div>

                        <form method="post" asp-page-handler="CreateReservation" class="emp-form">
                            <input type="hidden" name="custId" value="@wc.Id" />

                            <div class="row mb-3">
                                <div class="col">
                                    <label>Site</label>
                                    <select class="form-select" name="siteId" required>
                                        <option value="">-- Select a site --</option>
                                        @foreach (var s in Model.SiteOptions)
                                        {
                                            <option value="@s.Id">@s.SiteNumber</option>
                                        }
                                    </select>
                                </div>
                                <div class="col">
                                    <label>Total Cost</label>
                                    <input class="form-control" type="number" step="0.01" min="0" name="totalCost" value="0.00" required />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col">
                                    <label>Start Date</label>
                                    <input class="form-control" type="date" name="startDate" required />
                                </div>
                                <div class="col">
                                    <label>End Date</label>
                                    <input class="form-control" type="date" name="endDate" required />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col">
                                    <label>Adults</label>
                                    <input class="form-control" type="number" min="1" name="adults" value="1" required />
                                </div>
                                <div class="col">
                                    <label>Children</label>
                                    <input class="form-control" type="number" min="0" name="children" value="0" />
                                </div>
                                <div class="col">
                                    <label>Pets</label>
                                    <input class="form-control" type="number" min="0" max="4" name="pets" value="0" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col">
                                    <label>Notes</label>
                                    <textarea class="form-control" name="notes" rows="3" maxlength="500" placeholder="Special requests or notes for this reservation..."></textarea>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn-save">Create Reservation</button>
                                <a asp-page="" asp-route-mode="walkin" class="btn-save" style="background-color:#3a4048;">Back to Customer Search</a>
                            </div>
                        </form>
                    }
                }
                else if (Model.InvalidId)
                {
                    <p class="hint-text">We couldn't find that reservation. It may have been removed &mdash; try selecting one from the list.</p>
                }
                else if (Model.Mode == "details" && Model.Selected != null)
                {
                    var d = Model.Selected;
                    <div class="emp-detail-header">
                        <h3>Reservation #@d.Id &ndash; @d.CustomerName</h3>
                        <span class="badge-status @BadgeClass(d.Status)">@d.Status</span>
                    </div>

                    @if (d.Status == "Cancelled")
                    {
                        <div class="cancelled-banner">
                            <span>This reservation has been cancelled.</span>
                        </div>
                    }

                    <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:12px;">Customer</h5>
                    <div class="emp-info-grid" style="margin-bottom:20px;">
                        <div class="emp-info-item">
                            <label>Name</label>
                            <div class="value">@d.CustomerName</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Email</label>
                            <div class="value">@(d.CustomerFound ? d.CustomerEmail : "Not found")</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Phone</label>
                            <div class="value">@(d.CustomerFound ? d.CustomerPhone : "—")</div>
                        </div>
                    </div>

                    <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:12px;">Stay Details</h5>
                    <div class="emp-info-grid" style="margin-bottom:20px;">
                        <div class="emp-info-item">
                            <label>Site</label>
                            <div class="value">@d.SiteNumber</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Check-in</label>
                            <div class="value">@d.StartDate.ToString("MMM d, yyyy")</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Check-out</label>
                            <div class="value">@d.EndDate.ToString("MMM d, yyyy")</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Nights</label>
                            <div class="value">@d.Nights</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Adults</label>
                            <div class="value">@d.Adults</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Children</label>
                            <div class="value">@d.Children</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Pets</label>
                            <div class="value">@d.Pets</div>
                        </div>
                        <div class="emp-info-item">
                            <label>RV Length</label>
                            <div class="value">Not recorded</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Total Cost</label>
                            <div class="value">@d.TotalCost.ToString("C")</div>
                        </div>
                    </div>

                    <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:12px;">Special Requests / Notes</h5>
                    <p class="hint-text" style="padding:0 0 8px 0;">@(string.IsNullOrWhiteSpace(d.Notes) ? "None" : d.Notes)</p>

                    <h5 style="color:#ffffff; font-size:0.95rem; margin:20px 0 12px 0;">Payment Records</h5>
                    @if (d.Payments.Any())
                    {
                        <div class="emp-card" style="margin-top:0; padding:0; overflow:hidden;">
                            <table style="width:100%; border-collapse:collapse;">
                                <thead>
                                    <tr>
                                        <th style="text-align:left; padding:10px 16px; border-bottom:1px solid #3a4048; color:#9aa2ad; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">Date</th>
                                        <th style="text-align:left; padding:10px 16px; border-bottom:1px solid #3a4048; color:#9aa2ad; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">Amount</th>
                                        <th style="text-align:left; padding:10px 16px; border-bottom:1px solid #3a4048; color:#9aa2ad; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">Status</th>
                                        <th style="text-align:left; padding:10px 16px; border-bottom:1px solid #3a4048; color:#9aa2ad; font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em;">Reference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in d.Payments)
                                    {
                                        <tr>
                                            <td style="padding:10px 16px; border-bottom:1px solid #262b31; color:#e4e6eb;">@p.PaidAt.ToString("MMM d, yyyy")</td>
                                            <td style="padding:10px 16px; border-bottom:1px solid #262b31; color:#e4e6eb;">@p.Amount.ToString("C")</td>
                                            <td style="padding:10px 16px; border-bottom:1px solid #262b31; color:#e4e6eb;">@p.Status</td>
                                            <td style="padding:10px 16px; border-bottom:1px solid #262b31; color:#9aa2ad;">@p.StripeId</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="hint-text" style="padding:0 0 8px 0;">No payment records found for this reservation.</p>
                    }

                    <div class="mt-4">
                        <a asp-page="" asp-route-id="@d.Id" class="btn-save">Edit Reservation</a>
                        <a asp-page="" class="btn-save" style="background-color:#3a4048;">Back to List</a>
                    </div>
                }
                else if (Model.Selected != null)
                {
                    var d = Model.Selected;
                    <div class="emp-detail-header">
                        <h3>Reservation #@d.Id &ndash; @d.CustomerName</h3>
                        <span class="badge-status @BadgeClass(d.Status)">@d.Status</span>
                    </div>

                    @if (d.Status == "Cancelled")
                    {
                        <div class="cancelled-banner">
                            <span>This reservation has been cancelled.</span>
                            <form method="post" asp-page-handler="Reactivate" asp-route-id="@d.Id">
                                <button type="submit" class="btn-reactivate">Reactivate</button>
                            </form>
                        </div>
                    }

                    <div class="emp-info-grid">
                        <div class="emp-info-item">
                            <label>Site</label>
                            <div class="value">@d.SiteNumber</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Nights</label>
                            <div class="value">@d.Nights</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Total Cost</label>
                            <div class="value">@d.TotalCost.ToString("C")</div>
                        </div>
                        <div class="emp-info-item">
                            <label>Status</label>
                            <div class="value">@d.Status</div>
                        </div>
                    </div>

                    <h5 style="color:#ffffff; font-size:0.95rem; margin-bottom:12px;">Customer</h5>
                    @if (d.CustomerFound)
                    {
                        <div class="emp-info-grid" style="margin-bottom:20px;">
                            <div class="emp-info-item">
                                <label>Name</label>
                                <div class="value">@d.CustomerName</div>
                            </div>
                            <div class="emp-info-item">
                                <label>Email</label>
                                <div class="value">@d.CustomerEmail</div>
                            </div>
                            <div class="emp-info-item">
                                <label>Phone</label>
                                <div class="value">@d.CustomerPhone</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="hint-text" style="padding:0 0 12px 0;">Customer record not found</p>
                    }

                    <form method="post" asp-page-handler="Save" class="emp-form">
                        <input type="hidden" name="id" value="@d.Id" />

                        <div class="row mb-3">
                            <div class="col">
                                <label>Start Date</label>
                                <input class="form-control" type="date" name="startDate" value="@d.StartDate.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col">
                                <label>End Date</label>
                                <input class="form-control" type="date" name="endDate" value="@d.EndDate.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col">
                                <label>Adults</label>
                                <input class="form-control" type="number" min="1" name="adults" value="@d.Adults" required />
                            </div>
                            <div class="col">
                                <label>Children</label>
                                <input class="form-control" type="number" min="0" name="children" value="@d.Children" />
                            </div>
                            <div class="col">
                                <label>Pets</label>
                                <input class="form-control" type="number" min="0" name="pets" value="@d.Pets" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col">
                                <label>Notes</label>
                                <textarea class="form-control" name="notes" rows="3" placeholder="Special requests or notes for this reservation...">@d.Notes</textarea>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn-save">Save Changes</button>
                            <a asp-page="" asp-route-mode="details" asp-route-id="@d.Id" class="btn-save" style="background-color:#3a4048;">View Details</a>

                            @if (d.Status != "Cancelled")
                            {
                                <button type="submit" formaction="?handler=Cancel&id=@d.Id" class="btn-cancel-res"
                                        onclick="return confirm('Cancel this reservation? The customer will need to rebook if they change their mind.');">
                                    Cancel Reservation
                                </button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    <p class="hint-text">Select a reservation from the list to view details and assist a customer.</p>
                }
            </div>
        </div>
    </div>
</div>
