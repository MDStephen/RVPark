@page
@model AdminManageStaffModel
@{
    ViewData["Title"] = "Admin Manage Staff";
    ViewData["Page"] = "Users";
    var statusMsg = Model.StatusMessage;
    var isError = !string.IsNullOrEmpty(statusMsg) && statusMsg.StartsWith("Could not");
}

<div data-bs-theme="dark" class="text-light min-vh-100 px-3 px-md-4 py-3 py-md-4">
<div class="container-fluid p-0">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h4 fw-semibold mb-0 text-light">
            User Management
        </h1>
    </div>

    <!-- Customers | Staff -->
    <ul class="nav nav-tabs border-secondary border-opacity-25 border-opacity-25 mb-4">

        <li class="nav-item">
            <a
                href="/Admin/ManageUsers"
                class="nav-link text-secondary">
                Customers
            </a>
        </li>

        <li class="nav-item">
            <a
                href="/AdminManageStaff"
                class="nav-link active">
                Staff
            </a>
        </li>

    </ul>

    <!-- Status Message -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        if (isError)
        {
            <div
                class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-center mb-3"
                role="alert">

                <i class="bi bi-exclamation-triangle me-2"></i>

                <span>@statusMsg</span>

            </div>
        }
        else
        {
            <div
                class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-success d-flex align-items-center mb-3"
                role="alert">

                <i class="bi bi-check-circle me-2"></i>

                <span>@statusMsg</span>

            </div>
        }
    }

    <!-- Main Layout -->
    <div class="row g-3 g-lg-4 align-items-start">

        <!-- Staff List -->
        <div class="col-12 col-lg-3">

            <div class="card bg-dark border-secondary border-opacity-25 h-100 overflow-hidden">

                <!-- Panel Header -->
                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex align-items-center justify-content-between px-3 py-2">

                    <span class="small fw-semibold text-light">
                        Staff Users
                    </span>

                    <div class="d-flex gap-1">

                        <a
                            href="/AdminManageStaff?id=0"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Create User">

                            <i class="bi bi-person-plus"></i>

                        </a>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Filter">

                            <i class="bi bi-funnel"></i>

                        </button>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Refresh"
                            onclick="location.reload()">

                            <i class="bi bi-arrow-clockwise"></i>

                        </button>

                    </div>

                </div>

                <!-- Staff List -->
                <div class="list-group list-group-flush">

                    @foreach (var e in Model.Employees)
                    {
                        var isActive =
                            Model.Selected != null &&
                            Model.Selected.employeeId == e.employeeId;

                        <a
                            href="/AdminManageStaff?id=@e.employeeId"
                            class="list-group-item list-group-item-action bg-dark text-light border-secondary border-opacity-25 d-flex align-items-center gap-2 px-3 py-2 @(isActive ? "active" : "")">

                            <div
                                class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:32px;height:32px;">

                                <i class="bi bi-person-circle text-secondary"></i>

                            </div>

                            <span class="small fw-medium text-truncate">
                                @e.firstName @e.lastName
                            </span>

                            @if (e.isLocked)
                            {
                                <i
                                    class="bi bi-lock-fill ms-auto text-secondary flex-shrink-0"
                                    title="Locked">
                                </i>
                            }

                        </a>
                    }

                    @if (!Model.Employees.Any())
                    {
                        <div class="text-center text-secondary small py-4 px-3">
                            No staff found.
                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Edit Panel -->
        <div class="col-12 col-lg-9">

            @if (Model.Selected != null)
            {
                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body p-3 p-md-4">

                        <!-- User Header -->
                        <div class="d-flex align-items-center gap-3 mb-4">

                            <div
                                class="rounded-circle bg-secondary bg-opacity-25 border border-secondary border-opacity-25 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:72px;height:72px;">

                                <i class="bi bi-person-circle fs-1 text-secondary"></i>

                            </div>

                            <div class="min-w-0">

                                @if (Model.IsNew)
                                {
                                    <div class="fs-5 fw-semibold text-light text-truncate">
                                        New Staff Member
                                    </div>

                                    <div class="small text-secondary">
                                        Not yet created
                                    </div>
                                }
                                else
                                {
                                    <div class="fs-5 fw-semibold text-light text-truncate">
                                        @Model.Selected.firstName @Model.Selected.lastName
                                    </div>

                                    <div class="small text-secondary">
                                        @Model.Selected.role@(Model.Selected.isLocked ? " · Locked" : "")
                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Save / Lock Form -->
                        <form method="post">

                            <input
                                type="hidden"
                                name="id"
                                value="@Model.Selected.employeeId" />

                            <!-- First Name / Last Name -->
                            <div class="row g-3 mb-3">

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        First Name
                                    </label>

                                    <input
                                        name="firstName"
                                        value="@Model.Selected.firstName"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="First name"
                                        required />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Last Name
                                    </label>

                                    <input
                                        name="lastName"
                                        value="@Model.Selected.lastName"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="Last name"
                                        required />

                                </div>

                            </div>

                            <!-- Date of Birth / Role -->
                            <div class="row g-3 mb-3">

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Date of Birth
                                    </label>

                                    <input
                                        type="date"
                                        name="dateOfBirth"
                                        value="@(Model.Selected.dateOfBirth == default ? "" : Model.Selected.dateOfBirth.ToString("yyyy-MM-dd"))"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        required />

                                </div>

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Role
                                    </label>

                                    <select
                                        name="role"
                                        class="form-select bg-dark text-light border-secondary border-opacity-25">

                                        <option
                                            value="Employee"
                                            selected="@(Model.Selected.role == "Employee")">
                                            Employee
                                        </option>

                                        <option
                                            value="Admin"
                                            selected="@(Model.Selected.role == "Admin")">
                                            Admin
                                        </option>

                                    </select>

                                </div>

                            </div>

                            <!-- Username / Password -->
                            <div class="row g-3">

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Username
                                    </label>

                                    @if (Model.IsNew)
                                    {
                                        <input
                                            name="username"
                                            value="@Model.Selected.username"
                                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                                            placeholder="Username"
                                            required />
                                    }
                                    else
                                    {
                                        <input
                                            value="@Model.Selected.username"
                                            class="form-control bg-dark text-secondary border-secondary border-opacity-25"
                                            disabled />
                                    }

                                </div>

                                <div class="col-12 col-md-6">

                                    <label
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Password
                                    </label>

                                    @if (Model.IsNew)
                                    {
                                        <input
                                            name="password"
                                            type="password"
                                            value="@Model.Selected.password"
                                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                                            placeholder="Password"
                                            required />
                                    }
                                    else
                                    {
                                        <input
                                            value="@Model.Selected.password"
                                            class="form-control bg-dark text-secondary border-secondary border-opacity-25"
                                            disabled />
                                    }

                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex flex-wrap gap-2 mt-4">

                                <button
                                    type="submit"
                                    asp-page-handler="Save"
                                    class="btn btn-primary px-4">

                                    Save Changes

                                </button>

                                @if (Model.Selected.isLocked)
                                {
                                    <button
                                        type="submit"
                                        asp-page-handler="Unlock"
                                        class="btn btn-outline-light px-4"
                                        disabled="@Model.IsNew">

                                        Unlock User

                                    </button>
                                }
                                else
                                {
                                    <button
                                        type="submit"
                                        asp-page-handler="Lock"
                                        class="btn btn-outline-light px-4"
                                        disabled="@Model.IsNew"
                                        title="@(Model.IsNew ? "Save this user before locking their access" : null)">

                                        Lock User

                                    </button>
                                }

                            </div>

                        </form>

                        <!-- Delete Form -->
                        @{
                            var deleteLabel = Model.IsNew
                                ? "Discard this new staff member? Nothing has been saved yet."
                                : $"Delete {Model.Selected.firstName} {Model.Selected.lastName}? This cannot be undone.";
                        }
                        <form
                            method="post"
                            asp-page-handler="Delete"
                            onsubmit="return confirm('@deleteLabel');">

                            <input
                                type="hidden"
                                name="id"
                                value="@Model.Selected.employeeId" />

                            <div class="d-flex flex-wrap gap-2 mt-2">

                                <button
                                    type="submit"
                                    class="btn btn-danger px-4">

                                    Delete User

                                </button>

                            </div>

                        </form>

                    </div>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body text-center text-secondary py-5 px-3">

                        <i class="bi bi-person-x d-block fs-1 mb-3"></i>

                        <div class="small">
                            Select a staff member from the list to view and edit their details.
                        </div>

                    </div>

                </div>
            }

            @if (!Model.IsNew)
            {
                <div class="text-end text-secondary small fst-italic opacity-75 mt-2">
                    <div>Created @Model.Selected.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</div>
                    <div>Last modified @Model.Selected.LastModifiedAt.ToString("MMM d, yyyy 'at' h:mm tt")</div>
                </div>
            }

        </div>

    </div>

</div>
