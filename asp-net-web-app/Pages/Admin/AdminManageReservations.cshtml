@page "{handler?}/{id?}"
@model asp_net_web_app.Pages.AdminManageReservationsModel
@{
    ViewData["Title"] = "Admin - Manage Reservations";
    ViewData["Page"]  = "Reservations";
}

<div data-bs-theme="dark" class="text-light min-vh-100 px-3 px-md-4 py-3 py-md-4">
<div class="container-fluid p-0">

    @if (Model.BalanceDiff.HasValue)
    {
        <div class="card bg-dark border-warning border-opacity-25 mb-4">
            <div class="card-body py-3">
                <p class="mb-0 text-light">
                    Balance adjustment from last edit:
                    <strong class="@(Model.BalanceDiff >= 0 ? "text-warning" : "text-success")">
                        @(Model.BalanceDiff >= 0 ? "+" : "")@Model.BalanceDiff.Value.ToString("F2")
                    </strong>
                    (@(Model.BalanceDiff >= 0 ? "additional payment due" : "refund owed"))
                </p>
            </div>
        </div>
    }

    @if (Model.CurrentAction == "List")
    {
        <!-- Page Header -->
        <div class="mb-4">
            <h1 class="h4 fw-semibold text-light mb-1">
                Reservation Management
            </h1>

            <p class="small text-secondary mb-0">
                Search, edit, and cancel guest reservations.
            </p>
        </div>

        <!-- Search / Actions -->
        <div class="row g-3 align-items-end mb-4">

            <div class="col-12 col-xl">
                <div class="card bg-dark border-secondary border-opacity-25">
                    <div class="card-body p-3">

                        <form method="get">
                            <div class="row g-2 align-items-end">

                                <div class="col-12 col-md">
                                    <label class="form-label small text-secondary text-uppercase fw-semibold">
                                        Search by Reservation # or Customer Name
                                    </label>

                                    <input
                                        name="search"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        value="@Model.SearchTerm"
                                        placeholder="e.g. 3 or Alice" />
                                </div>

                                <div class="col-12 col-md-auto">
                                    <button
                                        type="submit"
                                        class="btn btn-primary w-100">

                                        Search
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                                {
                                    <div class="col-12 col-md-auto">
                                        <a
                                            asp-page=""
                                            class="btn btn-outline-secondary w-100">

                                            Clear
                                        </a>
                                    </div>
                                }

                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-auto">
                <a
                    asp-page-handler="CreateReservation"
                    class="btn btn-primary w-100">

                    + New Reservation
                </a>
            </div>

            <div class="col-12 col-sm-auto">
                <a
                    asp-page="/Payment/AlternativePayment"
                    class="btn btn-primary w-100">

                    Make a Payment
                </a>
            </div>

        </div>

        <!-- Reservation Table -->
        <div class="card bg-dark border-secondary border-opacity-25 overflow-hidden">

            <div class="table-responsive">

                <table class="table table-dark table-hover align-middle mb-0">

                    <thead>
                        <tr class="text-secondary small text-uppercase">

                            <th class="ps-4 py-3">
                                Res #
                            </th>

                            <th class="py-3">
                                Customer
                            </th>

                            <th class="py-3">
                                Site
                            </th>

                            <th class="py-3">
                                Dates
                            </th>

                            <th class="py-3">
                                Status
                            </th>

                            <th class="py-3">
                                Total
                            </th>

                            <th class="text-end pe-4 py-3">
                                Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.AllReservations.Any())
                        {
                            @foreach (var r in Model.AllReservations)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold text-light">
                                        #@r.Id
                                    </td>

                                    <td>
                                        @r.CustomerName
                                    </td>

                                    <td>
                                        <span class="badge text-bg-secondary">
                                            @r.SiteNumber
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @r.StartDate.ToShortDateString()
                                        –
                                        @r.EndDate.ToShortDateString()
                                    </td>

                                    <td>
                                        @r.Status
                                    </td>

                                    <td class="text-nowrap">
                                        $@r.TotalCost.ToString("F2")
                                    </td>

                                    <td class="text-end pe-4 text-nowrap">

                                        <button
                                            type="button"
                                            onclick="showReservationDetails(@r.Id)"
                                            class="btn btn-sm btn-outline-secondary me-1">

                                            View
                                        </button>

                                        <a
                                            asp-page-handler="CreateReservation"
                                            asp-route-id="@r.Id"
                                            class="btn btn-sm btn-outline-primary me-1">

                                            Edit
                                        </a>

                                        @if (r.Status != "Cancelled")
                                        {
                                            <form
                                                method="post"
                                                asp-page-handler="CancelReservation"
                                                asp-route-id="@r.Id"
                                                class="d-inline"
                                                onclick="return confirm('Cancel this reservation?');">

                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-outline-warning me-1">

                                                    Cancel
                                                </button>

                                            </form>
                                        }

                                        <form
                                            method="post"
                                            asp-page-handler="DeleteReservation"
                                            asp-route-id="@r.Id"
                                            class="d-inline"
                                            onclick="return confirm('Delete permanently?');">

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td
                                    colspan="7"
                                    class="text-center text-secondary py-5">

                                    No reservations found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    @if (Model.CurrentAction == "Create" || Model.CurrentAction == "Edit")
    {
        <!-- Back / Page Header -->
        <div class="mb-4">

            <a
                asp-page=""
                class="small text-secondary text-decoration-none">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Reservations
            </a>

            <h1 class="h5 fw-semibold text-light mt-2 mb-0">
                @(Model.CurrentAction == "Create"
                    ? "New Reservation"
                    : $"Edit Reservation #{Model.ActiveId}")
            </h1>

        </div>

        <!-- Reservation Form -->
        <div class="card bg-dark border-secondary border-opacity-25 w-100">

            <div class="card-body p-3 p-md-4">

                @if (Model.SelectedCustomer == null)
                {
                    <!-- Step 1: Find or Create Customer -->
                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">
                        Step 1 &ndash; Find or Create Customer
                    </h2>

                    <form method="get" class="mb-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">
                                    Search Customers
                                </label>

                                <input
                                    name="custQ"
                                    value="@Model.CustomerQuery"
                                    class="form-control bg-dark text-light border-secondary border-opacity-25"
                                    placeholder="Name, email, or phone" />
                            </div>

                            <div class="col-12 col-md-auto">
                                <button type="submit" class="btn btn-primary w-100">Search</button>
                            </div>
                        </div>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.CustomerQuery))
                    {
                        @if (Model.CustomerMatches.Any())
                        {
                            <div class="list-group mb-4">
                                @foreach (var c in Model.CustomerMatches)
                                {
                                    <div class="list-group-item bg-dark text-light border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="fw-semibold text-light">@c.FullName</div>
                                            <div class="small text-secondary">@c.Email &middot; @c.Phone</div>
                                        </div>

                                        <a
                                            asp-page-handler="CreateReservation"
                                            asp-route-id="@(Model.CurrentAction == "Edit" ? (int?)Model.ActiveId : null)"
                                            asp-route-custId="@c.Id"
                                            class="btn btn-sm btn-outline-primary">

                                            Select
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-secondary small mb-4">No matching customers found for "@Model.CustomerQuery".</p>
                        }
                    }

                    @if (Model.CustomerErrors.Any())
                    {
                        <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger mb-4">
                            @foreach (var err in Model.CustomerErrors)
                            {
                                <p class="mb-1">@err</p>
                            }

                            @if (Model.DuplicateEmailCustomer != null)
                            {
                                <a
                                    asp-page-handler="CreateReservation"
                                    asp-route-id="@(Model.CurrentAction == "Edit" ? (int?)Model.ActiveId : null)"
                                    asp-route-custId="@Model.DuplicateEmailCustomer.Id"
                                    class="btn btn-sm btn-outline-light mt-2">

                                    Use existing customer: @Model.DuplicateEmailCustomer.FullName
                                </a>
                            }
                        </div>
                    }

                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Or Create New Customer</h2>

                    <form method="post" asp-page-handler="CreateCustomer">
                        <input type="hidden" name="reservationId" value="@Model.ActiveId" />
                        <input type="hidden" name="custQ" value="@Model.CustomerQuery" />

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">First Name</label>
                                <input type="text" name="firstName" value="@Model.NewCustomerFirstName" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">Last Name</label>
                                <input type="text" name="lastName" value="@Model.NewCustomerLastName" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">Email Address</label>
                                <input type="email" name="email" value="@Model.NewCustomerEmail" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-secondary text-uppercase fw-semibold">Phone Number</label>
                                <input type="tel" name="phone" value="@Model.NewCustomerPhone" placeholder="(555) 123-4567" class="form-control bg-dark text-light border-secondary border-opacity-25" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-secondary text-uppercase fw-semibold">Address</label>
                            <input type="text" name="address" value="@Model.NewCustomerAddress" class="form-control bg-dark text-light border-secondary border-opacity-25" />
                        </div>

                        <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3 mt-4">
                            <button type="submit" class="btn btn-success">Create Customer</button>
                            <a asp-page="" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
                else
                {
                    <!-- Selected customer summary -->
                    <div class="mb-4">
                        <label class="form-label small text-secondary text-uppercase fw-semibold">Customer</label>

                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 bg-black bg-opacity-25 border border-secondary border-opacity-25 rounded p-3">
                            <div>
                                <div class="fw-semibold text-light">@Model.SelectedCustomer.FullName</div>
                                <div class="small text-secondary">@Model.SelectedCustomer.Email &middot; @Model.SelectedCustomer.Phone</div>
                            </div>

                            <a
                                asp-page-handler="CreateReservation"
                                asp-route-id="@(Model.CurrentAction == "Edit" ? (int?)Model.ActiveId : null)"
                                asp-route-changeCustomer="true"
                                class="btn btn-sm btn-outline-secondary">

                                Change Customer
                            </a>
                        </div>
                    </div>

                <form
                    method="post"
                    asp-page-handler="@(Model.CurrentAction == "Edit"
                        ? "UpdateReservation"
                        : "CreateReservation")">

                    <input
                        type="hidden"
                        name="reservationId"
                        value="@Model.ActiveId" />

                    <input
                        type="hidden"
                        name="userId"
                        value="@Model.SelectedCustomer.Id" />

                    <!-- Site -->
                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Site
                        </label>

                        <select
                            name="siteId"
                            class="form-select bg-dark text-light border-secondary border-opacity-25">

                            @foreach (var s in Model.AllSites)
                            {
                                <option
                                    value="@s.Id"
                                    selected="@(s.Id == Model.ActiveSiteId)">

                                    @s.SiteNumber (@s.Category)

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Start Date -->
                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Start Date
                        </label>

                        <input
                            type="date"
                            name="startDate"
                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                            value="@Model.ActiveStartDate.ToString("yyyy-MM-dd")"
                            required />

                    </div>

                    <!-- End Date -->
                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            End Date
                        </label>

                        <input
                            type="date"
                            name="endDate"
                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                            value="@Model.ActiveEndDate.ToString("yyyy-MM-dd")"
                            required />

                    </div>

                    <!-- Status -->
                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Status
                        </label>

                        <select
                            name="status"
                            class="form-select bg-dark text-light border-secondary border-opacity-25">

                            @foreach (var opt in new[] { "Upcoming", "In Progress", "Completed", "Cancelled" })
                            {
                                <option
                                    value="@opt"
                                    selected="@(opt == Model.ActiveStatus)">

                                    @opt

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Total Cost -->
                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Total Cost ($)
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            name="totalCost"
                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                            value="@Model.ActiveCost"
                            required />

                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3 mt-4">

                        <button
                            type="submit"
                            class="btn btn-success">

                            @(Model.CurrentAction == "Edit"
                                ? "Update Reservation"
                                : "Create Reservation")

                        </button>

                        <a
                            asp-page=""
                            class="btn btn-outline-secondary">

                            Cancel

                        </a>

                    </div>

                </form>
                }

            </div>

        </div>
    }

</div>

<div class="modal fade" id="reservationDetailsModal" tabindex="-1" aria-labelledby="reservationDetailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary border-opacity-25 text-light">
            <div class="modal-header border-secondary border-opacity-25">
                <h5 class="modal-title" id="reservationDetailsTitle">Reservation Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div id="reservationDetailsLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div id="reservationDetailsError" class="text-danger py-3" style="display:none;"></div>

                <div id="reservationDetailsContent" style="display:none;">

                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Customer</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <div class="small text-secondary text-uppercase">Name</div>
                            <div class="fw-semibold text-light" id="rdCustomerName"></div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="small text-secondary text-uppercase">Email</div>
                            <div class="fw-semibold text-light" id="rdCustomerEmail"></div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="small text-secondary text-uppercase">Phone</div>
                            <div class="fw-semibold text-light" id="rdCustomerPhone"></div>
                        </div>
                    </div>

                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Stay</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Site</div>
                            <div class="fw-semibold text-light" id="rdSiteNumber"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Site Type</div>
                            <div class="fw-semibold text-light" id="rdSiteType"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Status</div>
                            <div class="fw-semibold text-light" id="rdStatus"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Check-in</div>
                            <div class="fw-semibold text-light" id="rdCheckIn"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Check-out</div>
                            <div class="fw-semibold text-light" id="rdCheckOut"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Nights</div>
                            <div class="fw-semibold text-light" id="rdNights"></div>
                        </div>
                    </div>

                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Rate Breakdown</h2>
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Rate / Night</div>
                            <div class="fw-semibold text-light" id="rdRatePerNight"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Nights</div>
                            <div class="fw-semibold text-light" id="rdRateNights"></div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="small text-secondary text-uppercase">Total Cost</div>
                            <div class="fw-semibold text-light" id="rdTotalCost"></div>
                        </div>
                    </div>

                    <h2 class="small text-secondary text-uppercase fw-semibold mb-3">Payments</h2>

                    <div class="table-responsive mb-2">
                        <table class="table table-dark table-hover align-middle mb-0" id="rdPaymentsTable">
                            <thead>
                                <tr class="text-secondary small text-uppercase">
                                    <th class="py-2">Date</th>
                                    <th class="py-2">Amount</th>
                                    <th class="py-2">Status</th>
                                    <th class="py-2">Reference</th>
                                </tr>
                            </thead>
                            <tbody id="rdPaymentsBody"></tbody>
                        </table>
                    </div>
                    <p id="rdNoPayments" class="text-secondary small" style="display:none;">No payments recorded.</p>

                    <div class="row g-3 mt-2 border-top border-secondary border-opacity-25 pt-3">
                        <div class="col-6">
                            <div class="small text-secondary text-uppercase">Amount Paid</div>
                            <div class="fw-semibold text-light" id="rdAmountPaid"></div>
                        </div>
                        <div class="col-6">
                            <div class="small text-secondary text-uppercase">Balance Owed</div>
                            <div class="fw-semibold text-light" id="rdBalanceOwed"></div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let reservationDetailsModalInstance = null;

        function getReservationDetailsModal() {
            if (!reservationDetailsModalInstance) {
                reservationDetailsModalInstance = new bootstrap.Modal(document.getElementById('reservationDetailsModal'));
            }
            return reservationDetailsModalInstance;
        }

        function formatCurrency(value) {
            const num = Number(value) || 0;
            return '$' + num.toFixed(2);
        }

        function formatDate(value) {
            const d = new Date(value);
            if (isNaN(d.getTime())) return '';
            return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function setText(id, text) {
            document.getElementById(id).textContent = text;
        }

        async function showReservationDetails(id) {
            const loadingEl = document.getElementById('reservationDetailsLoading');
            const errorEl = document.getElementById('reservationDetailsError');
            const contentEl = document.getElementById('reservationDetailsContent');
            const titleEl = document.getElementById('reservationDetailsTitle');

            titleEl.textContent = 'Reservation #' + id;
            loadingEl.style.display = '';
            errorEl.style.display = 'none';
            contentEl.style.display = 'none';
            errorEl.textContent = '';

            getReservationDetailsModal().show();

            try {
                const response = await fetch('?handler=Details&id=' + encodeURIComponent(id), {
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    throw new Error('Request failed with status ' + response.status);
                }

                const data = await response.json();
                populateReservationDetails(data);

                loadingEl.style.display = 'none';
                contentEl.style.display = '';
            } catch (err) {
                loadingEl.style.display = 'none';
                errorEl.textContent = 'Unable to load reservation details. Please try again.';
                errorEl.style.display = '';
            }
        }

        function populateReservationDetails(d) {
            document.getElementById('reservationDetailsTitle').textContent = 'Reservation #' + d.id + ' – ' + d.customerName;

            setText('rdCustomerName', d.customerFound ? d.customerName : 'Unknown');
            setText('rdCustomerEmail', d.customerFound && d.customerEmail ? d.customerEmail : '—');
            setText('rdCustomerPhone', d.customerFound && d.customerPhone ? d.customerPhone : '—');

            setText('rdSiteNumber', d.siteNumber);
            setText('rdSiteType', d.siteType || '—');
            setText('rdStatus', d.status);
            setText('rdCheckIn', formatDate(d.startDate));
            setText('rdCheckOut', formatDate(d.endDate));
            setText('rdNights', d.nights);

            setText('rdRatePerNight', formatCurrency(d.ratePerNight));
            setText('rdRateNights', d.nights);
            setText('rdTotalCost', formatCurrency(d.totalCost));

            const paymentsBody = document.getElementById('rdPaymentsBody');
            const paymentsTable = document.getElementById('rdPaymentsTable');
            const noPayments = document.getElementById('rdNoPayments');
            paymentsBody.innerHTML = '';

            if (d.payments && d.payments.length > 0) {
                paymentsTable.style.display = '';
                noPayments.style.display = 'none';
                d.payments.forEach(p => {
                    const row = document.createElement('tr');

                    const dateCell = document.createElement('td');
                    dateCell.textContent = formatDate(p.paidAt);
                    row.appendChild(dateCell);

                    const amountCell = document.createElement('td');
                    amountCell.textContent = formatCurrency(p.amount);
                    row.appendChild(amountCell);

                    const statusCell = document.createElement('td');
                    statusCell.textContent = p.status;
                    row.appendChild(statusCell);

                    const refCell = document.createElement('td');
                    refCell.textContent = p.reference || '—';
                    row.appendChild(refCell);

                    paymentsBody.appendChild(row);
                });
            } else {
                paymentsTable.style.display = 'none';
                noPayments.style.display = '';
            }

            setText('rdAmountPaid', formatCurrency(d.amountPaid));
            setText('rdBalanceOwed', formatCurrency(d.balanceOwed));
        }
    </script>
}
