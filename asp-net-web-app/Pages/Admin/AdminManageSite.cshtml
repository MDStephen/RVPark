@page "{handler?}/{id?}"
@model asp_net_web_app.Pages.AdminManageSiteModel
@{
ViewData["Title"] = "Admin - Manage Sites";
}

<div data-bs-theme="dark" class="text-light px-3 px-md-4 py-3 py-md-4">
<div class="container-fluid p-0">

    <!-- View 1: Main Page -->
    @if (Model.CurrentAction == "List")
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

            <div>
                <h1 class="h4 fw-semibold text-light mb-1">
                    Site Inventory Management
                </h1>

                <p class="small text-secondary mb-0">
                    Configure park locations, photo portfolios, and dynamic price windows.
                </p>
            </div>

            <a
                asp-page-handler="CreateSite"
                class="btn btn-primary">

                + Add Property Site
            </a>

        </div>

        <div class="card bg-dark border-secondary border-opacity-25 overflow-hidden">

            <div class="table-responsive">

                <table class="table table-dark table-hover align-middle mb-0">

                    <thead>
                        <tr class="text-secondary small text-uppercase">

                            <th class="ps-4 py-3">
                                Site Identifier
                            </th>

                            <th class="py-3">
                                Classification Category
                            </th>

                            <th class="py-3">
                                Operational Status
                            </th>

                            <th class="text-end pe-4 py-3">
                                Management Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.AllSites != null && Model.AllSites.Any())
                        {
                            @foreach (var site in Model.AllSites)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold text-light">
                                        @site.SiteNumber
                                    </td>

                                    <td>
                                        <span class="badge text-bg-secondary">
                                            @site.Category
                                        </span>
                                    </td>

                                    <td>
                                        @if (site.IsAvailable)
                                        {
                                            <span class="badge rounded-pill text-success bg-success bg-opacity-10 border border-success border-opacity-25">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill text-danger bg-danger bg-opacity-10 border border-danger border-opacity-25">
                                                In Use
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4 text-nowrap">

                                        <a
                                            asp-page-handler="CreateSite"
                                            asp-route-id="@site.Id"
                                            class="btn btn-sm btn-outline-primary me-1">

                                            Edit
                                        </a>

                                        <a
                                            asp-page-handler="ManagePhotos"
                                            asp-route-id="@site.Id"
                                            class="btn btn-sm btn-outline-primary me-1">

                                            Photos
                                        </a>

                                        <a
                                            asp-page-handler="ManagePrices"
                                            asp-route-id="@site.Id"
                                            class="btn btn-sm btn-outline-warning me-1">

                                            Rates
                                        </a>

                                        <form
                                            method="post"
                                            asp-page-handler="DeleteSite"
                                            asp-route-siteId="@site.Id"
                                            class="d-inline"
                                            onclick="return confirm('Delete this site permanently?');">

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td
                                    colspan="4"
                                    class="text-center text-secondary py-5">

                                    No property sites available. Click "+ Add Property Site" to create one.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

    <!-- View 2: Site Creator/Manager -->
    @if (Model.CurrentAction == "Create" || Model.CurrentAction == "Edit")
    {
        <div class="mb-4">

            <a
                asp-page=""
                class="small text-secondary text-decoration-none">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Site Control Hub
            </a>

            <h1 class="h5 fw-semibold text-light mt-2 mb-0">
                @(Model.CurrentAction == "Create"
                    ? "Provision New Site Location"
                    : $"Modify Configuration for Site {Model.ActiveSiteNumber}")
            </h1>

        </div>

        <div class="card bg-dark border-secondary border-opacity-25 w-100">

            <div class="card-body p-3 p-md-4">

                <form
                    method="post"
                    asp-page-handler="@(Model.CurrentAction == "Edit" ? "UpdateSite" : "CreateSite")">

                    <input
                        type="hidden"
                        name="siteId"
                        value="@Model.ActiveSiteId" />

                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Site Designation / Number
                        </label>

                        <input
                            name="siteNum"
                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                            value="@(Model.CurrentAction == "Edit" ? Model.ActiveSiteNumber : "")"
                            placeholder="e.g., Premium-RV-40"
                            required />

                    </div>

                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Classification Category Type
                        </label>

                        <select
                            name="category"
                            class="form-select bg-dark text-light border-secondary border-opacity-25">

                            <option value="Tent Site">
                                Tent Site
                            </option>

                            <option value="RV Hookup">
                                RV Hookup
                            </option>

                            <option value="RV Parking">
                                RV Parking
                            </option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label small text-secondary text-uppercase fw-semibold">
                            Operational Status
                        </label>

                        <select
                            name="isAvailable"
                            class="form-select bg-dark text-light border-secondary border-opacity-25">

                            @if (Model.ActiveSiteStatus == true)
                            {
                                <option value="true" selected>
                                    Available
                                </option>

                                <option value="false">
                                    In Use
                                </option>
                            }
                            else
                            {
                                <option value="true">
                                    Available
                                </option>

                                <option value="false" selected>
                                    In Use
                                </option>
                            }

                        </select>

                    </div>

                    <div class="d-flex flex-wrap gap-2 border-top border-secondary border-opacity-25 pt-3 mt-4">

                        <button
                            type="submit"
                            class="btn btn-success">

                            @(Model.CurrentAction == "Edit"
                                ? "Update Details"
                                : "Commit Settings")

                        </button>

                        <a
                            asp-page=""
                            class="btn btn-outline-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>
    }

    <!-- View 3: Photo Manager -->
    @if (Model.CurrentAction == "Photos")
    {
        <div class="mb-4">

            <a
                asp-page=""
                class="small text-secondary text-decoration-none">

                <i class="bi bi-arrow-left me-1"></i>
                Save and Return to Inventory
            </a>

            <h1 class="h5 fw-semibold text-light mt-2 mb-0">
                Photo Portfolio Management

                <span class="small text-secondary">
                    (Site @Model.ActiveSiteNumber)
                </span>
            </h1>

        </div>

        <div class="row g-3 g-lg-4 align-items-start">

            <!-- Upload -->
            <div class="col-12 col-lg-4">

                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body p-3 p-md-4">

                        <h5 class="small text-secondary text-uppercase fw-semibold mb-3">
                            Attach New Asset
                        </h5>

                        <form
                            method="post"
                            asp-page-handler="AddPhoto"
                            enctype="multipart/form-data">

                            <input
                                type="hidden"
                                name="siteId"
                                value="@Model.ActiveSiteId" />

                            <div class="mb-3">

                                <label class="form-label small text-secondary text-uppercase fw-semibold">
                                    Select Image File
                                </label>

                                <input
                                    type="file"
                                    name="PhotoFile"
                                    accept="image/*"
                                    class="form-control bg-dark text-light border-secondary border-opacity-25"
                                    required />

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary w-100">

                                Upload Asset

                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <!-- Portfolio -->
            <div class="col-12 col-lg-8">

                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body p-3 p-md-4">

                        <h5 class="small text-secondary text-uppercase fw-semibold mb-3">
                            Active Portfolio Items
                        </h5>

                        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3">

                            @if (Model.SelectedPhotos.Any())
                            {
                                @foreach (var photo in Model.SelectedPhotos)
                                {
                                    <div class="col">

                                        <div
                                            class="position-relative bg-dark border border-secondary border-opacity-25 rounded overflow-hidden"
                                            style="height:120px;">

                                            <div
                                                class="w-100 h-100"
                                                style="background-image:url('@photo.PhotoUrl'); background-size:cover; background-position:center;">
                                            </div>

                                            <form
                                                method="post"
                                                asp-page-handler="DeletePhoto"
                                                class="position-absolute top-0 end-0 m-2">

                                                <input
                                                    type="hidden"
                                                    name="photoId"
                                                    value="@photo.Id" />

                                                <input
                                                    type="hidden"
                                                    name="siteId"
                                                    value="@Model.ActiveSiteId" />

                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-danger p-0 d-flex align-items-center justify-content-center"
                                                    style="width:24px;height:24px;"
                                                    title="Delete Photo">

                                                    &times;

                                                </button>

                                            </form>

                                            <div
                                                class="position-absolute bottom-0 start-0 end-0 bg-dark bg-opacity-75 text-center text-secondary px-1 py-1 small text-truncate"
                                                style="font-family:monospace; font-size:.65rem;">

                                                @photo.PhotoUrl

                                            </div>

                                        </div>

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12">

                                    <p class="text-secondary small mb-0">
                                        No photos uploaded for this site yet.
                                    </p>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>
    }

    <!-- View 4: Rates & Price Manager -->
    @if (Model.CurrentAction == "Prices")
    {
        <div class="mb-4">

            <a
                asp-page=""
                class="small text-secondary text-decoration-none">

                <i class="bi bi-arrow-left me-1"></i>
                Save and Return to Inventory
            </a>

            <h1 class="h5 fw-semibold text-light mt-2 mb-0">

                Dynamic Seasonal Pricing

                <span class="small text-secondary">
                    (Site @Model.ActiveSiteNumber)
                </span>

            </h1>

        </div>

        <div class="row g-3 g-lg-4 align-items-start">

            <!-- Add Price -->
            <div class="col-12 col-lg-4">

                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body p-3 p-md-4">

                        <h5 class="small text-secondary text-uppercase fw-semibold mb-3">
                            Create Active Price Window
                        </h5>

                        <form
                            method="post"
                            asp-page-handler="AddPrice">

                            <input
                                type="hidden"
                                name="siteId"
                                value="@Model.ActiveSiteId" />

                            <div class="mb-3">

                                <label class="form-label small text-secondary text-uppercase fw-semibold">
                                    Daily Rate ($)
                                </label>

                                <input
                                    name="cost"
                                    type="number"
                                    step="0.01"
                                    class="form-control bg-dark text-light border-secondary border-opacity-25"
                                    required />

                            </div>

                            <div class="mb-3">

                                <label class="form-label small text-secondary text-uppercase fw-semibold">
                                    Effective Activation Date
                                </label>

                                <input
                                    name="start"
                                    type="date"
                                    class="form-control bg-dark text-light border-secondary border-opacity-25"
                                    value="2026-07-09"
                                    required />

                            </div>

                            <div class="mb-3">

                                <label class="form-label small text-secondary text-uppercase fw-semibold">
                                    Deactivation Expiry Date
                                </label>

                                <input
                                    name="end"
                                    type="date"
                                    class="form-control bg-dark text-light border-secondary border-opacity-25"
                                    value="2026-07-16"
                                    required />

                            </div>

                            <button
                                type="submit"
                                class="btn btn-warning w-100">

                                Apply Rate Rule

                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <!-- Price Schedule -->
            <div class="col-12 col-lg-8">

                <div class="card bg-dark border-secondary border-opacity-25 overflow-hidden">

                    <div class="card-header bg-dark border-secondary border-opacity-25 px-3 px-md-4 py-3">

                        <h5 class="small text-secondary text-uppercase fw-semibold mb-0">
                            Active Price Schedules
                        </h5>

                    </div>

                    <div class="table-responsive">

                        <table class="table table-dark table-hover align-middle mb-0">

                            <thead>
                                <tr class="text-secondary small text-uppercase">

                                    <th class="ps-4 py-3">
                                        Price (Per Night)
                                    </th>

                                    <th class="py-3">
                                        Effective Start
                                    </th>

                                    <th class="py-3">
                                        Effective End
                                    </th>

                                    <th class="text-end pe-4 py-3">
                                        Actions
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.SelectedPrices.Any())
                                {
                                    @foreach (var price in Model.SelectedPrices)
                                    {
                                        <tr>

                                            <td class="ps-4 fw-semibold text-warning">
                                                $@price.Cost.ToString("F2")
                                            </td>

                                            <td class="text-light">
                                                @price.Start.ToShortDateString()
                                            </td>

                                            <td class="text-light">
                                                @price.End.ToShortDateString()
                                            </td>

                                            <td class="text-end pe-4">

                                                <form
                                                    method="post"
                                                    asp-page-handler="DeletePrice"
                                                    asp-route-priceId="@price.Id"
                                                    asp-route-siteId="@Model.ActiveSiteId"
                                                    class="d-inline">

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                        Remove

                                                    </button>

                                                </form>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td
                                            colspan="4"
                                            class="text-center text-secondary py-5">

                                            No dynamic rates configured for this site.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
    }

</div>
