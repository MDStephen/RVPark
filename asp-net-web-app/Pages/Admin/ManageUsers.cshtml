@page
@model asp_net_web_app.Pages.Admin.ManageUsersModel
@{
    ViewData["Title"] = "Admin Manage User";
    ViewData["Page"] = "Users";
    var statusMsg = TempData["StatusMessage"]?.ToString();
}

<div data-bs-theme="dark" class="text-light min-vh-100 px-3 px-md-4 py-3 py-md-4">
<div class="container-fluid p-0">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h4 fw-semibold mb-0 text-light">
            User Management
        </h1>
    </div>

    <!-- Customers | Staff -->
    <ul class="nav nav-tabs border-secondary border-opacity-25 mb-4">
        <li class="nav-item">
            <a
                href="/Admin/ManageUsers"
                class="nav-link active">
                Customers
            </a>
        </li>

        <li class="nav-item">
            <a
                href="/Admin/AdminManageStaff"
                class="nav-link text-secondary">
                Staff
            </a>
        </li>
    </ul>

    <!-- Status Messages -->
    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div
            class="alert alert-success bg-success bg-opacity-10 border-success border-opacity-25 text-success d-flex align-items-center mb-3"
            role="alert">

            <i class="bi bi-check-circle me-2"></i>

            <span>@statusMsg</span>
        </div>
    }

    @if (Model.IsError)
    {
        <div
            class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger d-flex align-items-center mb-3"
            role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            <span>@Model.StatusMessage</span>
        </div>
    }

    <!-- Main Layout -->
    <div class="row g-3 g-lg-4 align-items-start">

        <!-- Customer List -->
        <div class="col-12 col-lg-3">

            <div class="card bg-dark border-secondary border-opacity-25 h-100 overflow-hidden">

                <!-- Panel Header -->
                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex align-items-center justify-content-between px-3 py-2">

                    <span class="small fw-semibold text-light">
                        Customer Users
                    </span>

                    <div class="d-flex gap-1">

                        <a
                            href="/Admin/ManageUsers?selectedId=0"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Create User">

                            <i class="bi bi-person-plus"></i>
                        </a>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Filter">

                            <i class="bi bi-funnel"></i>
                        </button>

                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary border-0"
                            title="Refresh"
                            onclick="location.reload()">

                            <i class="bi bi-arrow-clockwise"></i>
                        </button>

                    </div>
                </div>

                <!-- Customer List -->
                <div class="list-group list-group-flush">

                    @foreach (var u in Model.Customers)
                    {
                        var isActive = u.userId == Model.SelectedId;

                        <a
                            href="/Admin/ManageUsers?selectedId=@u.userId"
                            class="list-group-item list-group-item-action bg-dark text-light border-secondary border-opacity-25 d-flex align-items-center gap-2 px-3 py-2 @(isActive ? "active" : "")">

                            <div
                                class="rounded-circle bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:32px;height:32px;">

                                <i class="bi bi-person-circle text-secondary"></i>
                            </div>

                            <span class="small fw-medium text-truncate">
                                @u.firstName @u.lastName
                            </span>

                        </a>
                    }

                    @if (!Model.Customers.Any())
                    {
                        <div class="text-center text-secondary small py-4 px-3">
                            No customers found.
                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Edit Panel -->
        <div class="col-12 col-lg-9">

            @if (Model.SelectedUser != null)
            {
                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body p-3 p-md-4">

                        <!-- User Header -->
                        <div class="d-flex align-items-center gap-3 mb-4">

                            <div
                                class="rounded-circle bg-secondary bg-opacity-25 border border-secondary border-opacity-25 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:72px;height:72px;">

                                <i class="bi bi-person-circle fs-1 text-secondary"></i>
                            </div>

                            <div class="min-w-0">

                                @if (Model.IsNew)
                                {
                                    <div class="fs-5 fw-semibold text-light text-truncate">
                                        New Customer
                                    </div>

                                    <div class="small text-secondary">
                                        Not yet created
                                    </div>
                                }
                                else
                                {
                                    <div class="fs-5 fw-semibold text-light text-truncate">
                                        @Model.SelectedUser.firstName @Model.SelectedUser.lastName
                                    </div>

                                    <div class="small text-secondary text-break">
                                        @Model.SelectedUser.emailAddress
                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Save Form -->
                        <form method="post" asp-page-handler="Save">

                            <input
                                type="hidden"
                                asp-for="SelectedUser.userId" />

                            <!-- First / Last / Middle Initial -->
                            <div class="row g-3 mb-3">

                                <div class="col-12 col-md-5">

                                    <label
                                        asp-for="SelectedUser.firstName"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        First Name
                                    </label>

                                    <input
                                        asp-for="SelectedUser.firstName"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="First name" />

                                    <span
                                        asp-validation-for="SelectedUser.firstName"
                                        class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-5">

                                    <label
                                        asp-for="SelectedUser.lastName"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Last Name
                                    </label>

                                    <input
                                        asp-for="SelectedUser.lastName"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="Last name" />

                                    <span
                                        asp-validation-for="SelectedUser.lastName"
                                        class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-2">

                                    <label
                                        asp-for="SelectedUser.middleInitial"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        M.I.
                                    </label>

                                    <input
                                        asp-for="SelectedUser.middleInitial"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="M.I."
                                        maxlength="1" />

                                </div>

                            </div>

                            <!-- Address / Apt Suite -->
                            <div class="row g-3 mb-3">

                                <div class="col-12 col-md-8">

                                    <label
                                        asp-for="SelectedUser.address"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Address
                                    </label>

                                    <input
                                        asp-for="SelectedUser.address"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="Street address" />

                                    <span
                                        asp-validation-for="SelectedUser.address"
                                        class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-4">

                                    <label
                                        asp-for="SelectedUser.aptSuite"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Apt/Suite
                                    </label>

                                    <input
                                        asp-for="SelectedUser.aptSuite"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="Apt/Suite" />

                                </div>

                            </div>

                            <!-- Phone / Email -->
                            <div class="row g-3">

                                <div class="col-12 col-md-6">

                                    <label
                                        asp-for="SelectedUser.phoneNumber"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Phone
                                    </label>

                                    <input
                                        asp-for="SelectedUser.phoneNumber"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="(555) 000-0000" />

                                    <span
                                        asp-validation-for="SelectedUser.phoneNumber"
                                        class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label
                                        asp-for="SelectedUser.emailAddress"
                                        class="form-label small text-secondary fw-semibold text-uppercase">

                                        Email
                                    </label>

                                    <input
                                        asp-for="SelectedUser.emailAddress"
                                        type="email"
                                        class="form-control bg-dark text-light border-secondary border-opacity-25"
                                        placeholder="email@example.com" />

                                    <span
                                        asp-validation-for="SelectedUser.emailAddress"
                                        class="text-danger small">
                                    </span>

                                </div>

                            </div>

                            @if (Model.IsNew)
                            {
                                <!-- Username / Password — only asked for when creating the account;
                                     these become the customer's login (mirrors public sign-up). -->
                                <div class="row g-3 mt-0">

                                    <div class="col-12 col-md-6">

                                        <label
                                            asp-for="NewUsername"
                                            class="form-label small text-secondary fw-semibold text-uppercase">

                                            Username
                                        </label>

                                        <input
                                            asp-for="NewUsername"
                                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                                            placeholder="Username"
                                            required />

                                    </div>

                                    <div class="col-12 col-md-6">

                                        <label
                                            asp-for="NewPassword"
                                            class="form-label small text-secondary fw-semibold text-uppercase">

                                            Password
                                        </label>

                                        <input
                                            asp-for="NewPassword"
                                            type="password"
                                            class="form-control bg-dark text-light border-secondary border-opacity-25"
                                            placeholder="Password"
                                            required />

                                    </div>

                                </div>
                            }

                            <!-- Save Button -->
                            <div class="d-flex flex-wrap gap-2 mt-4">

                                <button
                                    type="submit"
                                    class="btn btn-primary px-4">

                                    Save Changes
                                </button>

                            </div>

                        </form>

                        <!-- Delete Form -->
                        @{
                            var deleteLabel = Model.IsNew
                                ? "Discard this new customer? Nothing has been saved yet."
                                : $"Delete {Model.SelectedUser.firstName} {Model.SelectedUser.lastName}? This cannot be undone.";
                        }
                        <form
                            method="post"
                            asp-page-handler="Delete"
                            onsubmit="return confirm('@deleteLabel');">

                            <input
                                type="hidden"
                                asp-for="SelectedUser.userId" />

                            <div class="d-flex flex-wrap gap-2 mt-2">

                                <button
                                    type="submit"
                                    class="btn btn-danger px-4">

                                    Delete User
                                </button>

                            </div>

                        </form>

                        @if (!Model.IsNew)
                        {
                            <div class="text-end text-secondary small fst-italic opacity-75 mt-2">
                                <div>Created @Model.SelectedUser.CreatedAt.ToString("MMM d, yyyy 'at' h:mm tt")</div>
                                <div>Last modified @Model.SelectedUser.LastModifiedAt.ToString("MMM d, yyyy 'at' h:mm tt")</div>
                            </div>
                        }

                    </div>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="card bg-dark border-secondary border-opacity-25">

                    <div class="card-body text-center text-secondary py-5 px-3">

                        <i class="bi bi-person-x d-block fs-1 mb-3"></i>

                        <div class="small">
                            Select a customer from the list to view and edit their details.
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
@await Html.PartialAsync("_ValidationScriptsPartial")
}
