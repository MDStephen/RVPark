@page
@model PricingModel
@{
    ViewData["Title"] = "Pricing";
    ViewData["Page"] = "Pricing";
}

<div data-bs-theme="dark" class="container text-light min-vh-100 px-3 px-md-4 py-3 py-md-4">
<h2>Pricing</h2>
<div class="card p-3">
    <form method="post">
        <h4 class="mb-3 text-secondary">Base Rates</h4>
        <div class="mb-3">
            <label class="form-label" asp-for="BaseNightlyRate">Base Nightly Rate</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" asp-for="BaseNightlyRate" asp-format="{0:F2}" type="number" step="0.01" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="BaseMonthlyRateStorage">Base Monthly Storage Rate</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" asp-for="BaseMonthlyRateStorage" asp-format="{0:F2}" type="number" step="0.01" />
            </div>
        </div>

        <h4 class="mt-4 mb-3 text-secondary">Multipliers</h4>
        <div class="mb-3">
            <label class="form-label" asp-for="SeasonMultiplier">Season Multiplier</label>
            <input class="form-control" asp-for="SeasonMultiplier" type="number" step="0.01" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="LargeSiteMultiplier">Large Site Multiplier</label>
            <input class="form-control" asp-for="LargeSiteMultiplier" type="number" step="0.01" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="UtilityMultiplier">Utility Multiplier</label>
            <input class="form-control" asp-for="UtilityMultiplier" type="number" step="0.01" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="SpecialEventMultiplier">Special Event Multiplier</label>
            <input class="form-control" asp-for="SpecialEventMultiplier" type="number" step="0.01" />
        </div>

        <h4 class="mt-4 mb-3 text-secondary">Fees</h4>
        <div class="mb-3">
            <label class="form-label" asp-for="CancellationFee">Cancellation Fee</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" asp-for="CancellationFee" asp-format="{0:F2}" type="number" step="0.01" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="EarlyCheckInFee">Early Check-In Fee</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" asp-for="EarlyCheckInFee" asp-format="{0:F2}" type="number" step="0.01" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="LateCheckOutFee">Late Check-Out Fee</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input class="form-control" asp-for="LateCheckOutFee" asp-format="{0:F2}" type="number" step="0.01" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </form>

    <p class="card-footnote mt-3">Updated @Model.LastUpdated.ToString("MMM d, yyyy 'at' h:mm tt")</p>
</div>

@if (Model.RequiresAdminLogin)
{
    <div class="modal fade" id="adminLoginModal" tabindex="-1" aria-labelledby="adminLoginModalLabel" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false" data-bs-theme="dark">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="AdminLogin">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold" id="adminLoginModalLabel">Administrative Access Required</h5>
                    </div>
                    <div class="modal-body">
                        <p class="text-secondary mb-3">Sign in with an admin account to view or change pricing.</p>

                        @if (!string.IsNullOrEmpty(Model.AdminLoginError))
                        {
                            <div class="alert alert-danger py-2">@Model.AdminLoginError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" asp-for="AdminUsername">Admin Username</label>
                            <input class="form-control" asp-for="AdminUsername" autofocus />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="AdminPassword">Password</label>
                            <input class="form-control" asp-for="AdminPassword" type="password" />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn btn-primary w-100">Log In</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new bootstrap.Modal(document.getElementById("adminLoginModal")).show();
        });
    </script>
}
