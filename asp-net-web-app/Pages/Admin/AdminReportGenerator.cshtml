@page
@model AdminReportGeneratorModel
@{
    ViewData["Title"] = "Admin Report Generator";
    ViewData["Page"] = "Reports";
}

<div class="container">

    <h1 class="mb-3">Report Generator</h1>

    @* Changing the table drops any old filters on purpose - they're for a different set of columns. *@
    <form method="get" class="mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Data Source</label>
                <select class="form-select" asp-for="SelectedTable" onchange="this.form.submit()">
                    @foreach (var table in Model.AvailableTables)
                    {
                        <option value="@table">@table</option>
                    }
                </select>
            </div>
        </div>
    </form>

    @if (Model.Filters.Count > 0)
    {
        <h6 class="mb-2">Filters</h6>
        @await Html.PartialAsync("_FilterPanel", (asp_net_web_app.Models.IFilterableListPage)Model)
    }

    @if (Model.Trends.Count > 0)
    {
        <hr class="my-4" />
        <h5 class="mb-3">
            Monthly Trends
            <span class="fw-normal">
                (@Model.TrendDateField by month@(Model.TrendAmountField != null ? $", count & {Model.TrendAmountField}" : ", count"))
            </span>
        </h5>
        <canvas id="trendsChart" height="90"></canvas>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
        <script>
            const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trends.Select(t => t.Month)));
            const trendCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trends.Select(t => t.Count)));
            const trendTotals = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trends.Select(t => t.Total)));

            new Chart(document.getElementById('trendsChart'), {
                type: 'bar',
                data: {
                    labels: trendLabels,
                    datasets: [
                        {
                            label: 'Count',
                            data: trendCounts,
                            yAxisID: 'y',
                            backgroundColor: 'rgba(13, 110, 253, 0.6)'
                        }
                        @if (Model.TrendAmountField != null)
                        {
                            <text>
                            ,{
                                label: '@Model.TrendAmountField',
                                data: trendTotals,
                                type: 'line',
                                yAxisID: 'y1',
                                borderColor: 'rgba(25, 135, 84, 1)',
                                backgroundColor: 'rgba(25, 135, 84, 0.2)'
                            }
                            </text>
                        }
                    ]
                },
                options: {
                    scales: {
                        y: { type: 'linear', position: 'left', beginAtZero: true, title: { display: true, text: 'Count' } }
                        @if (Model.TrendAmountField != null)
                        {
                            <text>,y1: { type: 'linear', position: 'right', beginAtZero: true, grid: { drawOnChartArea: false }, title: { display: true, text: '@Model.TrendAmountField' } }</text>
                        }
                    }
                }
            });
        </script>
    }

    <hr class="my-4" />

    <h5 class="mb-3">
        Preview
        <span class="fw-normal">
            (showing @Model.Rows.Count of @Model.FilteredCount matching row@(Model.FilteredCount == 1 ? "" : "s"))
        </span>
    </h5>

    @if (Model.Rows.Count == 0)
    {
        <p class="">No matching rows.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-sm">
                <thead>
                    <tr>
                        @foreach (var prop in Model.Rows[0].GetType().GetProperties())
                        {
                            <th>@prop.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var prop in row.GetType().GetProperties())
                            {
                                <td>@prop.GetValue(row)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <form method="post" asp-page-handler="GenerateReport">
        @* Carry the current table + active filters into the POST body, since the GET query
           string (where they live for the preview) isn't automatically resubmitted here. *@
        <input type="hidden" asp-for="SelectedTable" />
        @{
            var filterKeys = Model.Filters
                .SelectMany(f => f.Type is "StartDate" or "EndDate" ? new[] { $"{f.Name}_{f.Type}" } : new[] { f.Name })
                .ToHashSet();
        }
        @foreach (var kvp in Html.ViewContext.HttpContext.Request.Query)
        {
            if (filterKeys.Contains(kvp.Key))
            {
                <input type="hidden" name="@kvp.Key" value="@kvp.Value" />
            }
        }

        <label class="form-label d-block">Report Format</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="ReportType" value="PDF" checked>
            <label class="form-check-label">PDF</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="ReportType" value="CSV">
            <label class="form-check-label">CSV</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="ReportType" value="JSON">
            <label class="form-check-label">JSON</label>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary" @(Model.FilteredCount == 0 ? "disabled" : "")>
                Generate Report (@Model.FilteredCount row@(Model.FilteredCount == 1 ? "" : "s"))
            </button>
        </div>
    </form>

</div>
