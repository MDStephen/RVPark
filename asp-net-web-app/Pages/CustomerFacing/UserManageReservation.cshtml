@page
@model UserManageReservationsModel
@{
    ViewData["Title"] = "My Reservations";
    ViewData["Page"]  = "Reservations";
}

<div class="container-fluid py-4 text-light" data-bs-theme="dark">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1 text-white">My Reservations</h1>
        <p class="text-secondary mb-0">View your upcoming, active, and past site bookings.</p>
    </div>

    <!-- Search Bar -->
    <div class="card bg-dark border-secondary shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-2 align-items-end">
                    <div class="col-md-8 col-lg-6">
                        <label class="form-label text-uppercase text-secondary small fw-bold">
                            Search by Reservation # or Site Number
                        </label>
                        <input name="search" class="form-control bg-dark text-white border-secondary" value="@Model.SearchTerm" placeholder="e.g. 3 or A1" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <div class="col-auto">
                            <a asp-page="" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Reservations Table -->
    <div class="card bg-dark border-secondary shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="border-bottom border-secondary text-uppercase text-secondary small">
                    <tr>
                        <th class="ps-4">Res #</th>
                        <th>Site</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Total Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UserReservations.Any())
                    {
                        @foreach (var r in Model.UserReservations)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-white">#@r.Id</td>
                                <td>
                                    <span class="badge bg-secondary">@r.SiteNumber</span>
                                </td>
                                <td>@r.StartDate.ToShortDateString()</td>
                                <td>@r.EndDate.ToShortDateString()</td>
                                <td>
                                    @{
                                        var badgeClass = r.Status switch
                                        {
                                            "Upcoming" => "bg-primary",
                                            "In Progress" => "bg-warning text-dark",
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@r.Status</span>
                                </td>
                                <td class="text-end pe-4 fw-semibold text-white">
                                    @r.TotalCost.ToString("C")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-5">
                                No reservations found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
