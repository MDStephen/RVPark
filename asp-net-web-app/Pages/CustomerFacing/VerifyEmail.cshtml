@page
@model VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
    Layout = "_ExternalLayout";
}

<div class="container py-4">
    <h1 class="text-light mb-4">Email Verification</h1>

    <div class="card bg-secondary bg-opacity-10 border-secondary-subtle rounded-3">
        <div class="card-body p-4">
            <div class="bg-secondary bg-opacity-25 rounded-3 p-5 text-center">
                @if (Model.Success)
                {
                    <p class="text-info fw-semibold mb-4">@Model.Message</p>
                    <a asp-page="/CustomerFacing/UserLoginPage" class="btn btn-info text-dark fw-semibold px-4">Go to Login</a>
                }
                else
                {
                    <p class="text-warning fw-semibold mb-4">@Model.Message</p>
                    <a asp-page="/CustomerFacing/UserCreateAccountPage" class="link-info text-decoration-none">Back to Create Account</a>
                }
            </div>
        </div>
    </div>
</div>
