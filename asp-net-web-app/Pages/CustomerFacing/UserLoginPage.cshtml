@page
@model UserLoginPageModel
@{
    ViewData["Title"] = "Login";
    Layout = "_ExternalLayout";
}

<div class="container py-4">
    <h1 class="text-light mb-4">Login</h1>

    <div class="card bg-secondary bg-opacity-10 border-secondary-subtle rounded-3 mb-4">
        <div class="card-header bg-secondary bg-opacity-25 border-secondary-subtle">
            <span class="fw-semibold text-light">Log in using username and password</span>
        </div>

        <div class="card-body p-4">
            <div class="bg-secondary bg-opacity-25 rounded-3 p-5">
                <form method="post" class="mx-auto" style="max-width: 320px;">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label text-light fw-semibold">Username</label>
                        <input asp-for="Username" class="form-control bg-dark text-light border-secondary-subtle" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label text-light fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control bg-dark text-light border-secondary-subtle" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <button type="submit" class="btn btn-info text-dark fw-semibold px-4">Login</button>
                    </div>

                    <div class="mt-2">
                        <a asp-page="/CustomerFacing/UserCreateAccountPage" class="link-info small text-decoration-none">
                            Don't have an account? Create Account
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card bg-secondary bg-opacity-10 border-secondary-subtle rounded-3">
        <div class="card-header bg-secondary bg-opacity-25 border-secondary-subtle">
            <span class="fw-semibold text-light">Browse without logging in</span>
        </div>
        <div class="card-body">
            <p class="text-light mb-3">You can search campsites and view pricing without an account. Sign in when you're ready to book under your profile.</p>
            <a asp-page="/Campsites/Index" class="btn btn-outline-light rounded-pill">Browse &amp; Search Campsites</a>
        </div>
    </div>

    @* TODO: Implement credential validation, password hashing, and ASP.NET Identity/cookie auth once username/password strategy is finalized. *@
    @* TODO: Forgot Password and Request Access pages — pending account system design. *@
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
