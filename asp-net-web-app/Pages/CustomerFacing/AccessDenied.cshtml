@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "AccessDenied";
    Layout = "_ExternalLayout";
}

<div class="text-light text-center py-5">
    <div class="container">
        <div class="card bg-dark border-secondary shadow-lg mx-auto" style="max-width: 550px;">
            <div class="card-body p-5 text-light">
                <div class="display-4 mb-3">403</div>
                <h2 class="mb-3">Access Denied</h2>
                <p class="text-secondary mb-0">
                    You don't have permission to access this page.
                    Staff or administrator privileges are required.
                </p>
            </div>
        </div>
    </div>
</div>
